{
  "name": "dsh-univer-work",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Private Host-only DeepSeek Harness Client Shell for Univer Workspace.",
  "homepage": "https://github.com/dream-num/univer-workspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-num/univer-workspace.git",
    "directory": "apps/dsh-univer-work"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/worker.js",
    "dist/chunks",
    "dist/render-runtime",
    "cordis.patch.yml",
    "skills",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm --filter @univerjs/univer-workspace-client-core build && vite build && node scripts/package-content-runtime.mjs",
    "clean": "rm -rf dist",
    "package:smoke": "pnpm run build && node scripts/smoke-package.mjs",
    "package:smoke:restricted": "sh scripts/smoke-package-container.sh",
    "package:verify": "pnpm run build && node scripts/verify-package.mjs",
    "test": "pnpm run build && DSH_PARITY_SAFETY_REPORT=1 vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@univerjs-pro/cli-assets": "0.1.0",
    "@univerjs-pro/doc-typst-native-binding": "1.0.0-insiders.20260723-c21613b",
    "@univerjs-pro/exchange-node-binding": "0.1.0",
    "@univerjs-pro/engine-formula-rust-binding": "1.0.0-insiders.20260819-8209aa8",
    "@puppeteer/browsers": "3.2.1",
    "puppeteer-core": "25.8.0"
  },
  "optionalDependencies": {
    "@univerjs-pro/doc-typst-native-binding-darwin-arm64": "1.0.0-insiders.20260723-c21613b",
    "@univerjs-pro/doc-typst-native-binding-darwin-x64": "1.0.0-insiders.20260723-c21613b",
    "@univerjs-pro/doc-typst-native-binding-linux-arm64-gnu": "1.0.0-insiders.20260723-c21613b",
    "@univerjs-pro/doc-typst-native-binding-linux-x64-gnu": "1.0.0-insiders.20260723-c21613b",
    "@univerjs-pro/doc-typst-native-binding-win32-x64-msvc": "1.0.0-insiders.20260723-c21613b"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@univer-cli/api-reference": "1.0.0-beta.2",
    "@univer-cli/content-execution": "1.0.0-beta.2",
    "@univer-cli/content-inspection": "1.0.0-beta.2",
    "@univer-cli/generic-keyed-instance-pool": "1.0.0-beta.2",
    "@univer-cli/resource-library": "1.0.0-beta.2",
    "@univerjs/protocol": "1.0.0-beta.2",
    "@univerjs-pro/collaboration": "1.0.0-beta.2",
    "@univerjs/univer-workspace-client-core": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
