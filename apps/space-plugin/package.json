{
  "name": "dsh-space-plugin",
  "version": "0.18.3",
  "private": true,
  "type": "module",
  "description": "Space content workspace for official DeepSeek Harness Desktop",
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:release": "node scripts/package.mjs",
    "test": "node --test test/*.test.mjs",
    "dsh": "dsh",
    "typecheck": "node scripts/typecheck.mjs",
    "test:live": "node scripts/check-live.mjs",
    "seed:live": "node scripts/seed-live.mjs",
    "test:host": "node scripts/check-host-live.mjs",
    "seed:product": "node scripts/seed-product.mjs",
    "test:tools:live": "node scripts/check-tools-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/async-lock": "1.4.2",
    "@types/lodash-es": "4.17.12",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/rbush": "4.0.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.7",
    "@univerjs-pro/bases": "1.1.0",
    "@univerjs-pro/bases-ui": "1.1.0",
    "@univerjs-pro/boards": "1.1.0",
    "@univerjs-pro/boards-ui": "1.1.0",
    "@univerjs-pro/chart-embed": "1.1.0",
    "@univerjs-pro/collaboration-embed": "1.1.0",
    "@univerjs-pro/embed": "1.1.0",
    "@univerjs-pro/engine-formula": "1.1.0",
    "@univerjs-pro/slides": "1.1.0",
    "@univerjs-pro/slides-ui": "1.1.0",
    "@univerjs-pro/thread-comment-datasource": "1.1.0",
    "@univerjs/core": "1.1.0",
    "@univerjs/docs": "1.1.0",
    "@univerjs/docs-thread-comment-ui": "1.1.0",
    "@univerjs/docs-ui": "1.1.0",
    "@univerjs/drawing": "1.1.0",
    "@univerjs/drawing-ui": "1.1.0",
    "@univerjs/engine-formula": "1.1.0",
    "@univerjs/engine-render": "1.1.0",
    "@univerjs/preset-docs-core": "1.1.0",
    "@univerjs/preset-docs-drawing": "1.1.0",
    "@univerjs/preset-docs-thread-comment": "1.1.0",
    "@univerjs/preset-sheets-core": "1.1.0",
    "@univerjs/preset-sheets-drawing": "1.1.0",
    "@univerjs/preset-sheets-thread-comment": "1.1.0",
    "@univerjs/presets": "1.1.0",
    "@univerjs/sheets": "1.1.0",
    "@univerjs/sheets-formula": "1.1.0",
    "@univerjs/sheets-ui": "1.1.0",
    "@univerjs/thread-comment": "1.1.0",
    "@univerjs/thread-comment-ui": "1.1.0",
    "@univerjs/ui": "1.1.0",
    "@univerjs/univer-workspace-agent-runtime": "file:../../packages/workspace-agent-runtime",
    "@univerjs/univer-workspace-html-viewer": "file:../../packages/workspace-html-viewer",
    "echarts": "6.1.0",
    "esbuild": "0.27.7",
    "immer": "10.1.1",
    "lexical": "0.49.0",
    "postcss": "8.5.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "zustand": "4.5.7"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@univerjs-pro/collaboration": "1.1.0",
    "@univerjs-pro/collaboration-client": "1.1.0",
    "@univerjs-pro/collaboration-client-ui": "1.1.0",
    "@univerjs-pro/collaboration-service": "1.1.0",
    "@univerjs-pro/engine-formula-rust": "1.1.0",
    "@univerjs-pro/exchange-node": "1.1.0",
    "@univerjs-pro/license": "1.1.0",
    "@univerjs/network": "1.1.0",
    "@univerjs/protocol": "1.1.0",
    "lucide-react": "0.468.0",
    "rxjs": "7.8.2"
  },
  "license": "Apache-2.0"
}
