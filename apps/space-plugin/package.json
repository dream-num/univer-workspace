{
  "name": "dsh-space-plugin",
  "version": "0.18.4-preview.0",
  "private": true,
  "type": "module",
  "description": "Space content workspace for official DeepSeek Harness Desktop",
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:release": "node scripts/package.mjs",
    "test": "node --test test/*.test.mjs",
    "dsh": "dsh",
    "typecheck": "node scripts/typecheck.mjs",
    "test:live": "node scripts/check-live.mjs",
    "seed:live": "node scripts/seed-live.mjs",
    "test:host": "node scripts/check-host-live.mjs",
    "seed:product": "node scripts/seed-product.mjs",
    "test:tools:live": "node scripts/check-tools-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
