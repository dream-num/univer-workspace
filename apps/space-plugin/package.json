{
  "name": "dsh-space-plugin",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Independent read-only Space panel for official DSH; TASK-004 vertical slice.",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "dsh": "dsh",
    "typecheck": "tsc --pretty false",
    "test:live": "node scripts/check-live.mjs",
    "seed:live": "node scripts/seed-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "react": "18.3.1",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@univerjs-pro/collaboration": "1.1.0",
    "@univerjs-pro/collaboration-service": "1.1.0"
  },
  "license": "Apache-2.0"
}
