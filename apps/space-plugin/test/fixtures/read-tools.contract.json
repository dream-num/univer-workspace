  {
    "name": "univer_open",
    "description": "Open an authorized Workspace file by resourceId, nodeId, or unitId and return its stable identity and a Workspace reference. Use univer_inspect to read content on demand.",
    "parameters": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "unitId": {
          "type": "string"
        }
      }
    },
    "output": {}
  },
  {
    "name": "univer_inspect",
    "description": "Inspect an authorized Workspace document by nodeId, resourceId or unitId, or use the document admitted with this request. Docs, Sheets and Slides support the original structured SDK inspection; Sheet range accepts an exact selector such as Sheet1!A1:D20. Canvas, Relational Table and Pages expose bounded current Server content. With worktreeId inspect the authorized current draft. Never writes.",
    "parameters": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "unitId": {
          "type": "string"
        },
        "unitType": {
          "type": "string",
          "enum": [
            "doc",
            "sheet",
            "slide",
            "board",
            "base"
          ]
        },
        "revision": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "sheet": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "worktreeId": {
          "type": "string"
        }
      }
    },
    "output": {},
    "presentation": {
      "card": "generic",
      "title": "Read Workspace file",
      "kind": "read"
    }
  }
