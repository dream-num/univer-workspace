HOST=127.0.0.1
PORT=3020
# Optional authenticated Prometheus scrape endpoint; unset means /metrics returns 404.
# Use a random Bearer token of at least 32 characters. See ../../observability/README.md.
# METRICS_TOKEN=
LOG_LEVEL=info
SECURE_COOKIES=false
SESSION_TTL_MS=604800000
DATABASE_FILE=.data/univer-workspace.sqlite
COLLABORATION_DATABASE_FILE=.data/univer-collaboration.sqlite
BLOB_DIRECTORY=.data/univer-workspace-blobs
MAX_BLOB_BYTES=536870912

# Password registration, login, and password changes are enabled unless set to false.
# false requires Email sign-in, GitHub, Google, or Discord OAuth.
# Existing sessions stay valid until they expire.
# PASSWORD_AUTH_ENABLED=true

# Passwordless Email sign-in. A first successful code verification creates the User.
# Enabled when EMAIL_AUTH_ENABLED=true or any EMAIL_SMTP_* or EMAIL_FROM value is set.
# EMAIL_PROVIDER=smtp selects SMTP; console writes codes to the server log (development only).
# EMAIL_AUTH_ENABLED=true
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Univer Workspace
# EMAIL_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# SMTP credentials are used verbatim: no Base64 encoding, no URL escaping.
# Quote the value only if it contains spaces or a # character.
# EMAIL_SMTP_USER=your-ses-smtp-username
# EMAIL_SMTP_PASSWORD=your-ses-smtp-password

# Set to true on public trial deployments. Signed-in users then see a one-time notice
# that data durability is not guaranteed and a link to the open-source repository.
# TRIAL_DEPLOYMENT=false

# Configure all three values to enable GitHub login and account linking.
# GITHUB_CLIENT_ID=your-oauth-app-client-id
# GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
# GITHUB_CALLBACK_URL=http://127.0.0.1:5173/api/auth/github/callback
# Optional comma-separated organization allowlist. GitHub login, registration,
# and account linking then require active membership in at least one listed organization.
# GITHUB_ALLOWED_ORGANIZATIONS=your-github-organization

# Configure all three values to enable Google login and account linking.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_CALLBACK_URL=http://127.0.0.1:5173/api/auth/google/callback

# Configure all three values to enable Discord login and account linking.
# DISCORD_CLIENT_ID=your-discord-application-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret
# DISCORD_CALLBACK_URL=http://127.0.0.1:5173/api/auth/discord/callback

# Shared secret for POST /api/auth/discord/bot-login. Use at least 32 random characters.
# DISCORD_BOT_API_KEY=replace-with-a-long-random-secret

# Register external OAuth-style clients. A JSON object with a `clients` array.
# Internal confidential client and external Harness public client:
# OAUTH_CLIENTS_JSON={"clients":[{"clientId":"internal-service","clientSecret":"replace-with-32-plus-chars","redirectUris":["https://service.example/callback"],"scopes":["identity"]},{"clientId":"univer-workspace-harness","clientType":"public","requiresConsent":true,"redirectUris":["http://127.0.0.1:3101/auth/oauth/callback"],"scopes":["identity","session"]}]}

# A confidential client with "tokenExchange": true may exchange personal access tokens and MCP OAuth access
# tokens for Workspace sessions of at most 10 minutes. The MCP gateway uses one through its
# MCP_OAUTH_CLIENT_ID and MCP_OAUTH_CLIENT_SECRET:
# OAUTH_CLIENTS_JSON={"clients":[{"clientId":"univer-workspace-mcp-gateway","clientSecret":"replace-with-32-plus-chars","tokenExchange":true,"redirectUris":["https://mcp.example.com/unused"],"scopes":["identity"]}]}

# MCP OAuth for clients that register themselves, such as opencode, Claude and ChatGPT. List the MCP
# server URLs those clients may request, comma-separated and compared exactly; unset disables it.
# PUBLIC_ORIGIN is the Workspace origin the clients reach and becomes the OAuth issuer. In development
# use http://127.0.0.1:5173.
# MCP_RESOURCE_URLS=https://mcp.example.com/mcp
# PUBLIC_ORIGIN=https://space.example.com
# Registration returns 503 once this many clients exist.
# MCP_MAX_REGISTERED_CLIENTS=10000

# Optional override for the built-in 90-day browser runtime development license.
# Required for deployments whose browser host is not an authorized license domain.
VITE_UNIVER_LICENSE=

# Optional override for the built-in server license used by the Collaboration
# service and Office exchange. Set both together; without a licensed pair the
# SDKs fall back to their free tier.
# UNIVER_LICENSE=
# UNIVER_LICENSE_KEY=
