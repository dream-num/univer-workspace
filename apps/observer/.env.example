OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=3030
OBSERVER_SECURE_COOKIES=false
OBSERVER_SESSION_TTL_MS=604800000
OBSERVER_DATABASE_FILE=.data/univer-observer.sqlite

# Observer 仅以只读方式打开 Workspace 拥有的产品与 Collaboration 数据库。
WORKSPACE_DATABASE_FILE=../workspace/.data/univer-workspace.sqlite
COLLABORATION_DATABASE_FILE=../workspace/.data/univer-collaboration.sqlite
WORKSPACE_BLOB_DIRECTORY=../workspace/.data/univer-workspace-blobs
# WORKSPACE_VERSION=sha-or-release-tag

# 查询保护：Changeset 查询超时与单进程并发上限。
OBSERVER_QUERY_TIMEOUT_MS=10000
OBSERVER_MAX_CONCURRENT_QUERIES=2

# 三项必须同时配置；本地回调由 Observer Web 开发服务器代理。
# OBSERVER_GITHUB_CLIENT_ID=your-observer-oauth-app-client-id
# OBSERVER_GITHUB_CLIENT_SECRET=your-observer-oauth-app-client-secret
# OBSERVER_GITHUB_CALLBACK_URL=http://127.0.0.1:5174/api/auth/github/callback

# 仅用于创建首位 Observer Member。使用 `openssl rand -hex 32` 生成。
# OBSERVER_SETUP_TOKEN=replace-with-64-random-hex-characters
