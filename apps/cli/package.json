    "test": "pnpm build && pnpm test:package && vitest run --config vitest.config.ts",
    "test:package": "node --test scripts/package-artifact.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p render-runtime/tsconfig.json --noEmit"
