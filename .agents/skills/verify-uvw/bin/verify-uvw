#!/usr/bin/env bash
# Isolated Univer Workspace instance for verification runs.
# Usage: verify-uvw up | doctor | user [name] | env | uvw <args> | cli <label> <args> | mcp [options] <label> <tool> [json] | mcp-tools [options] <label> | mcp-resources [options] <label> | mcp-resource [options] <label> <uri> | mcp-instructions [options] <label> | mcp-token [--scopes list] [--name name] | mcp-logs | renderer-call <label> <op> | renderer-restart [max-runtimes] | down
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
WORKSPACE_APP="$REPO/apps/workspace"
CLI_MAIN="$REPO/apps/cli/dist/main.js"
ROOT="${VERIFY_UVW_ROOT:-/tmp/verify-uvw}"

MCP_CALL="$REPO/.agents/skills/verify-uvw/bin/mcp-call.mjs"
MCP_BUILD_INPUTS=(package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc patches 'tsconfig*.json' apps/mcp packages/client-core apps/cli/skill-data)

die() { echo "verify-uvw: $*" >&2; exit 1; }

run_dir() {
  local id="${VERIFY_UVW_RUN:-}"
  if [[ -z "$id" ]]; then
    [[ -L "$ROOT/current" ]] || die "no run; start one with: verify-uvw up"
    id="$(basename "$(readlink "$ROOT/current")")"
  fi
  [[ -f "$ROOT/$id/run.env" ]] || die "run $id has no run.env under $ROOT"
  echo "$ROOT/$id"
}

load_run() {
  RUN="$(run_dir)"
  # shellcheck disable=SC1091
  source "$RUN/run.env"
  ORIGIN="http://127.0.0.1:$WEB_PORT"
  export UNIVER_HOME="$RUN/home"
  export AGENT_BROWSER_SESSION="verify-uvw-$RUN_ID"
}

listener_pid() { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -n1 || true; }

deps_fresh() { cmp -s "$REPO/pnpm-lock.yaml" "$REPO/node_modules/.pnpm/lock.yaml"; }

cli_fresh() {
  [[ -f "$CLI_MAIN" && -f "$REPO/packages/client-core/dist/index.js" ]] || return 1
  [[ -z "$(find "$REPO/apps/cli/src" -newer "$CLI_MAIN" -type f -print -quit)" ]] || return 1
  [[ -z "$(find "$REPO/packages/client-core/src" -newer "$REPO/packages/client-core/dist/index.js" -type f -print -quit)" ]]
}

wait_http() { # url timeout-seconds
  local i
  for ((i = 0; i < $2; i++)); do
    curl -fsS -o /dev/null "$1" 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

uvw_raw() { node "$CLI_MAIN" "$@"; }

mcp_digest() {
  git -C "$REPO" ls-files -co --exclude-standard -z -- "${MCP_BUILD_INPUTS[@]}" | node -e '
    const fs = require("node:fs"), crypto = require("node:crypto");
    process.chdir(process.argv[1]);
    const paths = [...new Set(fs.readFileSync(0, "utf8").split("\0").filter(Boolean))].sort();
    const hash = crypto.createHash("sha256");
    for (const path of paths) {
      if (!fs.existsSync(path)) continue;
      hash.update(path).update("\0").update(fs.readFileSync(path)).update("\0");
    }
    console.log(hash.digest("hex"));
  ' "$REPO"
}

mcp_compose() {
  local executor_urls="http://executor:3000" profiles=""
  if [[ "${MCP_EXECUTORS:-1}" == 2 ]]; then
    executor_urls+=",http://executor-b:3000"
    profiles=replicas
  fi
  COMPOSE_PROFILES="$profiles" VERIFY_UVW_EXECUTOR_URLS="$executor_urls" \
  VERIFY_UVW_MCP_PROJECT="$MCP_PROJECT" VERIFY_UVW_MCP_IMAGE="$MCP_IMAGE" \
    VERIFY_UVW_ORIGIN="$ORIGIN" VERIFY_UVW_SERVER_PORT="$SERVER_PORT" \
    VERIFY_UVW_MCP_PORT="$MCP_PORT" VERIFY_UVW_METRICS_TOKEN="$(cat "$RUN/home/metrics-token" 2>/dev/null || echo removed)" \
    VERIFY_UVW_MCP_STAGING_DIRECTORY="$RUN/staging" \
    VERIFY_UVW_INTERNAL_TOKEN="$(cat "$RUN/home/internal-token" 2>/dev/null || echo removed)" \
    VERIFY_UVW_MCP_OAUTH_SECRET="$(cat "$RUN/home/mcp-oauth-secret" 2>/dev/null || echo removed)" \
    docker compose -p "$MCP_PROJECT" -f "$REPO/apps/mcp/docker/compose.verify.yml" "$@"
}

mcp_client() {
  node "$MCP_CALL" --repo "$REPO" --run "$RUN" --url "http://127.0.0.1:$MCP_PORT/mcp" \
    --project "$MCP_PROJECT" --image "$MCP_IMAGE" --origin "$ORIGIN" --server-port "$SERVER_PORT" "$@"
}

mcp_up() {
  load_run
  mkdir -m 700 "$RUN/staging"
  docker run --rm -v "$RUN/staging:/staging" --entrypoint sh node:24-bookworm-slim -c 'chown 1000:1000 /staging && chmod 700 /staging' >"$RUN/logs/staging-setup.log" 2>&1
  local digest
  digest="$(mcp_digest)"
  node -e 'const fs=require("node:fs"); fs.writeFileSync(process.argv[1], JSON.stringify({started_at:new Date().toISOString(),git_head:process.argv[2],source_digest:process.argv[3],image_id:null},null,2)+"\n")' \
    "$RUN/mcp-build.json" "$GIT_HEAD" "$digest"
  docker build -f "$REPO/apps/mcp/Dockerfile" -t "$MCP_IMAGE" \
    --label "org.opencontainers.image.revision=$GIT_HEAD" --label "dev.univer.verify-uvw.run=$RUN_ID" "$REPO" \
    >"$RUN/logs/mcp-build.log" 2>&1 \
    || { tail -n 40 "$RUN/logs/mcp-build.log" >&2; die "MCP build failed; run: verify-uvw down"; }
  MCP_IMAGE_ID="$(docker image inspect --format '{{.Id}}' "$MCP_IMAGE")"
  printf 'MCP_IMAGE_ID=%s\n' "$MCP_IMAGE_ID" >>"$RUN/run.env"
  node -e 'const fs=require("node:fs"),p=process.argv[1],v=JSON.parse(fs.readFileSync(p));v.image_id=process.argv[2];fs.writeFileSync(p,JSON.stringify(v,null,2)+"\n")' "$RUN/mcp-build.json" "$MCP_IMAGE_ID"
  (umask 077 && openssl rand -hex 24 >"$RUN/home/metrics-token")
  (umask 077 && openssl rand -hex 24 >"$RUN/home/internal-token")
  mcp_compose up -d --wait --wait-timeout 60 \
    || die "MCP gateway not ready; see compose logs and run: verify-uvw down"
  wait_http "http://127.0.0.1:$MCP_PORT/healthz" 60 || die "MCP healthz failed; run: verify-uvw down"
}

mcp_doctor() {
  node "$REPO/.agents/skills/verify-uvw/bin/executor-doctor.mjs" "$REPO" "$RUN" "$MCP_PROJECT" "$MCP_IMAGE" "${MCP_IMAGE_ID:-}" "$ORIGIN" "$SERVER_PORT" "$MCP_PORT" "${MCP_EXECUTORS:-1}" || bad "MCP executor checks failed"
  node "$REPO/.agents/skills/verify-uvw/bin/renderer-doctor.mjs" "$REPO" "$RUN" "$MCP_PROJECT" "$MCP_IMAGE" "${MCP_IMAGE_ID:-}" "$ORIGIN" "$SERVER_PORT" "$MCP_PORT" || bad "MCP renderer checks failed"
  if mcp_compose exec -T gateway node -e 'const fs=require("node:fs"),s=fs.lstatSync(process.env.MCP_STAGING_DIRECTORY);process.exit(s.isDirectory()&&s.uid===process.getuid()&&(s.mode&0o077)===0?0:1)' >/dev/null 2>&1; then
    ok "MCP staging directory is private and owned by the gateway uid"
  else bad "MCP staging directory is missing or unsafe"; fi
  local desktop digest cid inspect mapping gateway_logs who
  if desktop="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null)" && [[ "$desktop" == 'Docker Desktop' ]]; then
    ok "MCP Docker Desktop is available"
  else bad "MCP Docker Desktop unavailable; start Docker Desktop"; fi
  if digest="$(mcp_digest)" && node -e 'const fs=require("node:fs");process.exit(JSON.parse(fs.readFileSync(process.argv[1])).source_digest===process.argv[2]?0:1)' "$RUN/mcp-build.json" "$digest" 2>/dev/null; then
    ok "MCP image matches build inputs"
  else bad "MCP image is stale or build record missing: down, then up"; fi
  if cid="$(mcp_compose ps -q gateway 2>/dev/null)" && [[ -n "$cid" ]] && inspect="$(docker inspect "$cid" 2>/dev/null)"; then
    if node -e 'const c=JSON.parse(process.argv[1])[0];process.exit(c.State.Running&&c.State.Health?.Status==="healthy"&&c.Image===process.argv[2]?0:1)' "$inspect" "${MCP_IMAGE_ID:-}"; then
      ok "MCP gateway is healthy and uses this run's image"
    else bad "MCP gateway state or image mismatch: down, then up"; fi
    if node -e 'const e=JSON.parse(process.argv[1])[0].Config.Env;process.exit(e.includes("WORKSPACE_ORIGIN="+process.argv[2])&&e.includes("WORKSPACE_TRANSPORT_URL=http://host.docker.internal:"+process.argv[3])?0:1)' "$inspect" "$ORIGIN" "$SERVER_PORT"; then
      ok "MCP identity origin and Workspace transport match this run"
    else bad "MCP configuration drift: down, then up"; fi
  else
    bad "MCP cannot inspect gateway: down, then up"
    bad "MCP cannot verify container configuration: down, then up"
  fi
  if mapping="$(mcp_compose port gateway 3000 2>/dev/null)" && [[ "$mapping" == "127.0.0.1:$MCP_PORT" ]] && curl -fsS -o /dev/null "http://127.0.0.1:$MCP_PORT/healthz"; then
    ok "MCP loopback port mapping and healthz match this run"
  else bad "MCP port is occupied or mapped incorrectly"; fi
  if mcp_compose exec -T gateway node -e 'fetch(process.env.WORKSPACE_TRANSPORT_URL+"/api/session").then(r=>process.exit(r.status===200?0:1),()=>process.exit(1))' >/dev/null 2>&1; then
    ok "MCP container reaches this run's Workspace"
  else bad "MCP container cannot reach host Workspace; see local-verification section 2.1"; fi
  if [[ -f "$RUN/home/metrics-token" ]] && \
    [[ "$(curl -sS -o /dev/null -w '%{http_code}' "http://127.0.0.1:$MCP_PORT/metrics")" == 401 ]] && \
    [[ "$(curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(cat "$RUN/home/metrics-token")" "http://127.0.0.1:$MCP_PORT/metrics")" == 200 ]]; then
    ok "MCP metrics reject missing token and accept this run's token"
  else bad "MCP metrics token protection failed"; fi
  if [[ -f "$RUN/user.env" ]]; then
    if who="$(mcp_client doctor --auth dev doctor-whoami whoami)" && node -e 'const v=JSON.parse(process.argv[1]);process.exit(v.subject?.name===process.argv[2]&&v.origin===process.argv[3]?0:1)' "$who" "Verify $RUN_ID" "$ORIGIN"; then
      ok "MCP whoami returns this run's user"
    else bad "MCP whoami failed: run verify-uvw user"; fi
    if [[ -s "$RUN/home/mcp-token" ]] && who="$(mcp_client doctor --auth pat doctor-pat-whoami whoami)" \
      && node -e 'const v=JSON.parse(process.argv[1]);process.exit(v.subject?.name===process.argv[2]?0:1)' "$who" "Verify $RUN_ID"; then
      ok "MCP gateway exchanged this run's PAT for a downstream session"
    else bad "MCP PAT exchange failed: run verify-uvw mcp-token, and check the gateway client in OAUTH_CLIENTS_JSON"; fi
    if gateway_logs="$(mcp_compose logs --no-color --no-log-prefix gateway 2>/dev/null)" && [[ -s "$RUN/home/mcp-session" ]]; then
      if printf '%s' "$gateway_logs" | node -e 'const fs=require("node:fs");const logs=fs.readFileSync(0,"utf8");process.exit(process.argv.slice(1).filter(p=>fs.existsSync(p)).some(p=>logs.includes(fs.readFileSync(p,"utf8").trim()))?1:0)' "$RUN/home/mcp-session" "$RUN/home/mcp-token" "$RUN/home/mcp-oauth-secret"; then
        ok "MCP gateway logs contain no session, PAT or gateway client secret"
      else bad "MCP gateway leaks session credential; blocking defect"; fi
    else bad "MCP cannot check gateway logs or session; run verify-uvw user"; fi
    if [[ ! -s "$RUN/home/mcp-token" ]]; then
      bad "MCP cannot verify Workspace server logs: run verify-uvw mcp-token"
    elif node -e 'const fs=require("node:fs");const logs=fs.readFileSync(process.argv[1],"utf8");process.exit(process.argv.slice(2).some(p=>{const secret=fs.readFileSync(p,"utf8").trim();return !secret||logs.includes(secret)})?1:0)' "$RUN/logs/server.log" "$RUN/home/mcp-token" "$RUN/home/mcp-oauth-secret"; then
      ok "Workspace server logs contain no PAT or gateway client secret"
    else bad "MCP cannot verify Workspace server logs are free of PAT and gateway client secret; blocking defect"; fi
  fi
}

mcp_user() {
  node --input-type=module - "$RUN" "$ORIGIN" "$USERNAME" "$MCP_PORT" <<'JS'
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {randomBytes} from 'node:crypto';
const [run,origin,username,port]=process.argv.slice(2);
const response=await fetch(origin+'/api/auth/cli/password/login', {method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({username,password:readFileSync(run+'/user.pw','utf8')})});
if (!response.ok) throw new Error('MCP password login returned '+response.status);
const session=response.headers.getSetCookie().map(c=>/^workspace_session=([^;]+)/.exec(c)?.[1]).find(Boolean);
if (!session) throw new Error('MCP password login returned no session cookie');
writeFileSync(run+'/home/mcp-session',session,{mode:0o600});
const dir=run+'/home/opencode-'+randomBytes(4).toString('hex');
mkdirSync(dir,{mode:0o700});
writeFileSync(dir+'/opencode.json',JSON.stringify({$schema:'https://opencode.ai/config.json',mcp:{'verify-uvw':{type:'remote',url:`http://127.0.0.1:${port}/mcp`,enabled:true,headers:{Authorization:'Bearer '+session}}},permission:{edit:'deny',bash:'deny',webfetch:'deny'}},null,2)+'\n',{mode:0o600});
writeFileSync(run+'/home/opencode-dir',dir+'\n',{mode:0o600});
JS
}

mcp_token() { # [--scopes read,write,...] [--name name]
  [[ -s "$RUN/home/mcp-session" ]] || die "no MCP session; run: verify-uvw user"
  node --input-type=module - "$RUN" "$ORIGIN" "$RUN_ID" "$@" <<'JS'
import {readFileSync,writeFileSync} from 'node:fs';
const [run,origin,runId,...args]=process.argv.slice(2);
let name=`verify-uvw-${runId}`, scopes;
while (args.length) {
  const flag=args.shift(), value=args.shift();
  if (value===undefined) throw new Error(`Missing value for ${flag}`);
  if (flag==='--scopes') scopes=value.split(',').filter(Boolean);
  else if (flag==='--name') name=value;
  else throw new Error(`Unknown option ${flag}`);
}
const session=readFileSync(run+'/home/mcp-session','utf8').trim();
const response=await fetch(origin+'/api/auth/tokens', {method:'POST',headers:{'content-type':'application/json',cookie:'workspace_session='+session,origin},body:JSON.stringify({name,...(scopes?{scopes}:{})})});
if (response.status!==201) throw new Error('PAT creation returned '+response.status);
const {token,record}=await response.json();
if (typeof token!=='string' || typeof record?.id!=='string') throw new Error('PAT creation returned no token');
writeFileSync(run+'/home/mcp-token',token,{mode:0o600});
writeFileSync(run+'/home/mcp-token-id',record.id,{mode:0o600});
console.log(record.id);
JS
}

mcp_down() {
  mcp_compose logs --no-color --timestamps gateway >"$RUN/logs/mcp-gateway.log" 2>&1 || echo "warning: cannot save MCP logs" >&2
  mcp_compose logs --no-color --timestamps executor executor-b >"$RUN/logs/mcp-executor.log" 2>&1 || echo "warning: cannot save executor logs" >&2
  mcp_compose logs --no-color --timestamps renderer >"$RUN/logs/mcp-renderer.log" 2>&1 || echo "warning: cannot save renderer logs" >&2
  mcp_compose down --volumes --remove-orphans || echo "warning: MCP compose down failed; retry down" >&2
  if docker image inspect "$MCP_IMAGE" >/dev/null 2>&1; then
    docker image rm "$MCP_IMAGE" || echo "warning: cannot remove MCP image $MCP_IMAGE" >&2
  fi
  local kind remaining resource clean=1
  for kind in container network volume; do
    if remaining="$(docker "$kind" ls -q --filter "label=com.docker.compose.project=$MCP_PROJECT" 2>/dev/null)"; then
      if [[ -n "$remaining" ]]; then
        clean=0
        while IFS= read -r resource; do
          echo "warning: remaining MCP $kind $resource; remove with docker $kind rm $resource" >&2
        done <<<"$remaining"
      fi
    else clean=0; echo "warning: cannot list MCP $kind resources" >&2; fi
  done
  if remaining="$(docker image ls -q "$MCP_IMAGE" 2>/dev/null)"; then
    if [[ -n "$remaining" ]]; then clean=0; echo "warning: remaining MCP image $MCP_IMAGE; remove with docker image rm $MCP_IMAGE" >&2; fi
  else clean=0; echo "warning: cannot list MCP image" >&2; fi
  rm -rf "$RUN/staging"
  [[ ! -e "$RUN/staging" ]] || { clean=0; echo "warning: staging directory remains" >&2; }
  [[ "$clean" != 1 ]] || echo "ok    MCP resources removed"
}

cmd_mcp() {
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  mcp_client "$@"
}

cmd_renderer_call() { # label op, with the operation input as JSON on stdin
  [[ $# -eq 2 && "$1" =~ ^[A-Za-z0-9._-]{1,64}$ && "$2" =~ ^(screenshot|printPdf|lint|measureText)$ ]] || die "usage: verify-uvw renderer-call <label> screenshot|printPdf|lint|measureText < input.json"
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  local base="$RUN/evidence/$1" bin="$REPO/.agents/skills/verify-uvw/bin"
  printf 'renderer-call %s\n' "$2" >"$base.cmd"
  mcp_compose exec -T executor node --input-type=module -e "$(cat "$bin/renderer-call.mjs")" "$2" | node "$bin/renderer-save.mjs" "$base"
}

cmd_renderer_restart() { # [max-runtimes]: recreate only this run's renderer, optionally with another RENDERER_MAX_RUNTIMES
  [[ $# -le 1 && "${1:-2}" =~ ^[1-9][0-9]?$ ]] || die "usage: verify-uvw renderer-restart [max-runtimes]"
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  RENDERER_MAX_RUNTIMES="${1:-2}" mcp_compose up -d --force-recreate --no-deps --wait renderer >/dev/null 2>&1 || die "renderer did not become healthy"
  local i
  for ((i = 0; i < 60; i++)); do
    mcp_compose logs --no-log-prefix renderer 2>&1 | grep -q 'Renderer runtime warmed' && { echo "renderer restarted with RENDERER_MAX_RUNTIMES=${1:-2}, first runtime warm"; return 0; }
    sleep 1
  done
  die "renderer did not warm its first runtime within 60 s"
}

cmd_mcp_token() {
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  mcp_token "$@"
}

cmd_up() {
  deps_fresh || die "node_modules is older than pnpm-lock.yaml; run: pnpm install --frozen-lockfile"
  cli_fresh || die "CLI build is stale; run: pnpm --filter 'univer-workspace-cli...' build"
  local server_port="${VERIFY_UVW_SERVER_PORT:-3920}" web_port="${VERIFY_UVW_WEB_PORT:-5973}"
  local port
  for port in "$server_port" "$web_port"; do
    [[ -z "$(listener_pid "$port")" ]] || die "port $port is already in use; not driving an instance this run did not start"
  done

  [[ "${VERIFY_UVW_MCP_EXECUTORS:-1}" =~ ^[12]$ ]] || die "VERIFY_UVW_MCP_EXECUTORS must be 1 or 2"
  local id="${VERIFY_UVW_RUN:-$(date +%Y%m%d-%H%M%S)}"
  local mcp_enabled=0 mcp_port="${VERIFY_UVW_MCP_PORT:-3930}" desktop
  if [[ "${VERIFY_UVW_MCP:-0}" == 1 ]]; then
    mcp_enabled=1
    [[ "$id" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "MCP run id must match ^[a-z0-9][a-z0-9_-]*$; choose VERIFY_UVW_RUN"
    desktop="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null)" || die "start Docker Desktop before MCP verification"
    [[ "$desktop" == 'Docker Desktop' && "$(uname -s)" == Darwin ]] || die "MCP verification requires macOS Docker Desktop"
    [[ "$mcp_port" =~ ^[0-9]+$ && "$mcp_port" -ge 1 && "$mcp_port" -le 65535 ]] || die "choose VERIFY_UVW_MCP_PORT between 1 and 65535"
    [[ "$mcp_port" != "$server_port" && "$mcp_port" != "$web_port" && -z "$(listener_pid "$mcp_port")" ]] || die "MCP port $mcp_port is occupied; choose VERIFY_UVW_MCP_PORT"
  fi
  local run="$ROOT/$id"
  [[ ! -e "$run" ]] || die "$run already exists; pick another VERIFY_UVW_RUN"
  mkdir -p "$run"/{data,home,logs,evidence}
  local oauth_clients="" server_oauth_env=("OAUTH_CLIENTS_JSON=")
  if [[ "$mcp_enabled" == 1 ]]; then
    (umask 077 && openssl rand -hex 24 >"$run/home/mcp-oauth-secret")
    oauth_clients="$(node -e 'console.log(JSON.stringify({clients:[{clientId:"univer-workspace-mcp-gateway",clientType:"confidential",clientSecret:require("node:fs").readFileSync(process.argv[1],"utf8").trim(),tokenExchange:true,redirectUris:["http://127.0.0.1/unused"],scopes:["identity"]}]}))' "$run/home/mcp-oauth-secret")"
    server_oauth_env=("OAUTH_CLIENTS_JSON=$oauth_clients" "MCP_RESOURCE_URLS=http://127.0.0.1:$mcp_port/mcp" "PUBLIC_ORIGIN=http://127.0.0.1:$web_port")
  fi

  # env -i keeps the developer's shell and apps/workspace/.env (OAuth, data paths) out of this instance.
  (cd "$WORKSPACE_APP" && exec nohup env -i PATH="$PATH" HOME="$HOME" \
    HOST=127.0.0.1 PORT="$server_port" LOG_LEVEL=info SECURE_COOKIES=false \
    "${server_oauth_env[@]}" \
    DATABASE_FILE="$run/data/univer-workspace.sqlite" \
    COLLABORATION_DATABASE_FILE="$run/data/univer-collaboration.sqlite" \
    BLOB_DIRECTORY="$run/data/blobs" \
    node --import tsx server/src/main.ts >"$run/logs/server.log" 2>&1) &
  local server_pid=$!
  (cd "$WORKSPACE_APP" && exec nohup env -i PATH="$PATH" HOME="$HOME" WORKSPACE_DEV_API_PORT="$server_port" \
    node node_modules/vite/bin/vite.js --host 127.0.0.1 --port "$web_port" --strictPort \
    >"$run/logs/web.log" 2>&1) &
  local web_pid=$!

  cat >"$run/run.env" <<EOF
RUN_ID=$id
SERVER_PORT=$server_port
WEB_PORT=$web_port
SERVER_PID=$server_pid
WEB_PID=$web_pid
GIT_HEAD=$(git -C "$REPO" rev-parse HEAD)
EOF
  printf 'MCP_ENABLED=%s\n' "$mcp_enabled" >>"$run/run.env"
  if [[ "$mcp_enabled" == 1 ]]; then
    printf 'MCP_PORT=%s\nMCP_PROJECT=verify-uvw-%s\nMCP_IMAGE=univer-workspace-mcp:verify-%s\nMCP_EXECUTORS=%s\n' "$mcp_port" "$id" "$id" "${VERIFY_UVW_MCP_EXECUTORS:-1}" >>"$run/run.env"
  fi
  ln -sfn "$run" "$ROOT/current"

  wait_http "http://127.0.0.1:$server_port/api/session" 120 \
    || { tail -n 40 "$run/logs/server.log" >&2; die "server not ready; see $run/logs/server.log (run: verify-uvw down)"; }
  wait_http "http://127.0.0.1:$web_port/api/session" 60 \
    || { tail -n 40 "$run/logs/web.log" >&2; die "web not ready; see $run/logs/web.log (run: verify-uvw down)"; }
  [[ "$mcp_enabled" != 1 ]] || mcp_up
  echo "run:      $id"
  echo "web:      http://127.0.0.1:$web_port"
  echo "server:   http://127.0.0.1:$server_port"
  [[ "$mcp_enabled" != 1 ]] || echo "mcp:      http://127.0.0.1:$mcp_port/mcp"
  echo "evidence: $run/evidence"
}

cmd_doctor() {
  local fail=0
  ok() { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }
  deps_fresh && ok "node_modules matches pnpm-lock.yaml" \
    || bad "node_modules is stale: pnpm install --frozen-lockfile, then restart the run"
  cli_fresh && ok "CLI build is newer than apps/cli/src and packages/client-core/src" \
    || bad "CLI build is stale: pnpm --filter 'univer-workspace-cli...' build"
  load_run
  ok "run $RUN_ID at $RUN"
  local name pid port
  for name in SERVER WEB; do
    pid="${name}_PID"; pid="${!pid}"; port="${name}_PORT"; port="${!port}"
    if ! kill -0 "$pid" 2>/dev/null; then bad "$name pid $pid is not running"; continue; fi
    [[ "$(listener_pid "$port")" == "$pid" ]] && ok "$name port $port is owned by this run (pid $pid)" \
      || bad "$name port $port is owned by pid '$(listener_pid "$port")', not this run's $pid"
  done
  lsof -p "$SERVER_PID" 2>/dev/null | grep -F "$RUN/data/univer-workspace.sqlite" > /dev/null \
    && ok "server has this run's product database open" \
    || bad "server does not have $RUN/data/univer-workspace.sqlite open"
  curl -fsS -o /dev/null "$ORIGIN/api/session" && ok "$ORIGIN/api/session answers through the web proxy" \
    || bad "$ORIGIN/api/session does not answer"
  [[ "$(git -C "$REPO" rev-parse HEAD)" == "$GIT_HEAD" ]] && ok "HEAD unchanged since launch" \
    || bad "HEAD moved since launch; the server does not reload: down, then up"
  if [[ -f "$RUN/user.env" ]]; then
    # shellcheck disable=SC1091
    source "$RUN/user.env"
    uvw_raw auth status --json 2>/dev/null | grep -q "\"name\": \"Verify $RUN_ID\"" \
      && ok "uvw is signed in to $ORIGIN as $USERNAME (UNIVER_HOME=$UNIVER_HOME)" \
      || bad "uvw is not signed in as $USERNAME; run: verify-uvw user"
  else
    echo "info  no disposable user yet; run: verify-uvw user"
  fi
  [[ "${MCP_ENABLED:-0}" != 1 ]] || mcp_doctor
  return "$fail"
}

cmd_user() {
  load_run
  if [[ ! -f "$RUN/user.env" ]]; then
    local username="${1:-verify-$RUN_ID}"
    local password
    password="$(openssl rand -hex 16)"
    local status
    status="$(curl -sS -o "$RUN/logs/register.json" -w '%{http_code}' -X POST "$ORIGIN/api/auth/password/register" \
      -H 'content-type: application/json' \
      -d "{\"username\":\"$username\",\"displayName\":\"Verify $RUN_ID\",\"password\":\"$password\"}")"
    [[ "$status" == 201 ]] || die "register returned $status: $(cat "$RUN/logs/register.json")"
    (umask 077 && printf '%s' "$password" >"$RUN/user.pw")
    printf 'USERNAME=%s\n' "$username" >"$RUN/user.env"
  fi
  # shellcheck disable=SC1091
  source "$RUN/user.env"
  uvw_raw config set workspace.origin "$ORIGIN" >/dev/null
  uvw_raw auth login --username "$USERNAME" --password-stdin --json <"$RUN/user.pw"
  if [[ "${MCP_ENABLED:-0}" == 1 ]]; then
    mcp_user
    [[ -s "$RUN/home/mcp-token" ]] || mcp_token >/dev/null
  fi
  echo "username: $USERNAME"
  echo "password: $RUN/user.pw"
}

cmd_env() {
  load_run
  cat <<EOF
export VERIFY_UVW_RUN=$RUN_ID
export UNIVER_HOME=$UNIVER_HOME
export AGENT_BROWSER_SESSION=$AGENT_BROWSER_SESSION
export ORIGIN=$ORIGIN
export EVIDENCE=$RUN/evidence
EOF
  if [[ "${MCP_ENABLED:-0}" == 1 ]]; then
    cat <<EOF
export MCP_URL=http://127.0.0.1:$MCP_PORT/mcp
export MCP_PROJECT=$MCP_PROJECT
export MCP_IMAGE=$MCP_IMAGE
export MCP_OPENCODE_DIR=$(cat "$RUN/home/opencode-dir" 2>/dev/null || true)
export MCP_OPENCODE_MODEL=console-deepseek/deepseek-flash#high
# opencode: (cd "\$MCP_OPENCODE_DIR" && opencode run --format json -m "\$MCP_OPENCODE_MODEL" "<prompt>" < /dev/null)
EOF
  fi
}

cmd_cli() {
  [[ $# -ge 2 ]] || die "usage: verify-uvw cli <label> <uvw args...>"
  load_run
  local label="$1"; shift
  local base="$RUN/evidence/$label"
  printf 'uvw' >"$base.cmd"; printf ' %q' "$@" >>"$base.cmd"; echo >>"$base.cmd"
  local code=0
  uvw_raw "$@" >"$base.out" 2>"$base.err" || code=$?
  echo "$code" >"$base.exit"
  cat "$base.out"; cat "$base.err" >&2
  echo "[exit $code; evidence $base.{cmd,out,err,exit}]" >&2
  return "$code"
}

stop_pid() { # pid expected-command-fragment
  local pid="$1" children
  kill -0 "$pid" 2>/dev/null || return 0
  ps -p "$pid" -o command= | grep -q -- "$2" || { echo "skip pid $pid: not $2" >&2; return 0; }
  children="$(pgrep -P "$pid" || true)"
  kill "$pid" 2>/dev/null || true
  for _ in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
  kill -9 "$pid" 2>/dev/null || true
  [[ -z "$children" ]] || kill $children 2>/dev/null || true
}

cmd_down() {
  load_run
  [[ "${MCP_ENABLED:-0}" != 1 ]] || mcp_down
  agent-browser close >/dev/null 2>&1 || true
  uvw_raw daemon stop >/dev/null 2>&1 || true
  stop_pid "$SERVER_PID" "server/src/main.ts"
  stop_pid "$WEB_PID" "vite.js"
  rm -rf "$RUN/data" "$RUN/home" "$RUN/user.pw"
  [[ "$(readlink "$ROOT/current" 2>/dev/null)" != "$RUN" ]] || rm -f "$ROOT/current"
  echo "stopped run $RUN_ID; kept $RUN/evidence and $RUN/logs"
}

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  user) shift; cmd_user "$@" ;;
  env) shift; cmd_env "$@" ;;
  uvw) shift; load_run; uvw_raw "$@" ;;
  cli) shift; cmd_cli "$@" ;;
  mcp) shift; cmd_mcp call "$@" ;;
  mcp-tools) shift; cmd_mcp tools "$@" ;;
  mcp-resources) shift; cmd_mcp resources "$@" ;;
  mcp-resource) shift; cmd_mcp resource "$@" ;;
  mcp-instructions) shift; cmd_mcp instructions "$@" ;;
  mcp-token) shift; cmd_mcp_token "$@" ;;
  renderer-call) shift; cmd_renderer_call "$@" ;;
  renderer-restart) shift; cmd_renderer_restart "$@" ;;
  mcp-logs) shift; load_run; [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run"; mcp_compose logs --no-color --no-log-prefix gateway executor executor-b renderer ;;
  down) shift; cmd_down "$@" ;;
  *) sed -n 2,3p "$0" >&2; exit 2 ;;
esac
