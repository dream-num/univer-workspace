#!/usr/bin/env bash
# Isolated Univer Workspace instance for verification runs.
# Usage: verify-uvw up [--reuse] [--for <feature> [journey-id|mode...]] | doctor | user [name] | principal <name> [label] | story [--as identity] [--oauth] [--model id[#effort]] <label> mcp|uvw|codex <prompt> | open-anon <label> <url> | secret-check [directory] | env | brief <feature> [journey-id|mode...] | verifier ['<spec>'|off] | delegate <feature> [journey-id|mode...] | journeys <feature> [journey-id|mode...] | verdict <journey-id> PASS|FAIL|DRIFT|BLOCKED [note] | run-journeys [--again] <feature> [journey-id|mode...] | metrics | uvw <args> | cli <label> <args> | mcp [options] <label> <tool> [json] | mcp-tools [options] <label> | mcp-skills [options] <label> | mcp-resources [options] <label> | mcp-resource [options] <label> <uri> | mcp-instructions [options] <label> | mcp-token [--scopes list] [--name name] | mcp-oauth <login|refresh|reuse|revoke|direct|exchange> <label> [options] | mcp-allow-users <user-id>...|'*'|workspace | mcp-gateway-restart | mcp-logs | renderer-call <label> <op> | renderer-restart [max-runtimes] | agent-up | agent-down | down
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
WORKSPACE_APP="$REPO/apps/workspace"
CLI_MAIN="$REPO/apps/cli/dist/main.js"
ROOT="${VERIFY_UVW_ROOT:-/tmp/verify-uvw}"

BIN="$REPO/.agents/skills/verify-uvw/bin"
MCP_CALL="$BIN/mcp-call.mjs"
MCP_PROCESSES="$REPO/.agents/skills/verify-uvw/runner/mcp-processes.mjs"
OPENCODE_MODEL="${VERIFY_UVW_OPENCODE_MODEL:-console-deepseek/deepseek-flash#high}"
MCP_BUILD_INPUTS=(package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc patches 'tsconfig*.json' apps/mcp packages/client-core apps/cli/skill-data)

die() { echo "verify-uvw: $*" >&2; exit 1; }

run_dir() {
  local id="${VERIFY_UVW_RUN:-}"
  if [[ -z "$id" ]]; then
    [[ -L "$ROOT/current" ]] || die "no run; start one with: verify-uvw up"
    id="$(basename "$(readlink "$ROOT/current")")"
  fi
  [[ -f "$ROOT/$id/run.env" ]] || die "run $id has no run.env under $ROOT"
  echo "$ROOT/$id"
}

load_run() {
  RUN="$(run_dir)"
  # shellcheck disable=SC1091
  source "$RUN/run.env"
  ORIGIN="http://127.0.0.1:$WEB_PORT"
  MCP_URL="${MCP_PUBLIC_URL:-http://127.0.0.1:${MCP_PORT:-}/mcp}"
  export UNIVER_HOME="$RUN/home"
  export AGENT_BROWSER_SESSION="verify-uvw-$RUN_ID"
}

# Why the server answered 429 to an agent creation. A run started before up recorded its limit has the server default of 5.
agent_limit_reason() { echo "agent creation is limited to ${AGENT_CREATE_LIMIT:-5} per hour per source IP on run $RUN_ID; reuse an agent, or down and up again with a higher VERIFY_UVW_AGENT_CREATE_LIMIT (up's default is 100)"; }

listener_pid() { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -n1 || true; }

deps_fresh() { cmp -s "$REPO/pnpm-lock.yaml" "$REPO/node_modules/.pnpm/lock.yaml"; }

cli_fresh() {
  [[ -f "$CLI_MAIN" && -f "$REPO/packages/client-core/dist/index.js" ]] || return 1
  [[ -z "$(find "$REPO/apps/cli/src" -newer "$CLI_MAIN" -type f -print -quit)" ]] || return 1
  [[ -z "$(find "$REPO/packages/client-core/src" -newer "$REPO/packages/client-core/dist/index.js" -type f -print -quit)" ]]
}

wait_http() { # url timeout-seconds
  local i
  for ((i = 0; i < $2; i++)); do
    curl -fsS -o /dev/null "$1" 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

# Without workspace.origin uvw targets production, so refuse unless the CLI home resolves this run's origin.
uvw_raw() {
  [[ "$(node "$CLI_MAIN" config get workspace.origin --json 2>/dev/null)" == *"\"value\": \"$ORIGIN\""* ]] \
    || { echo "verify-uvw: refusing uvw: workspace.origin in $UNIVER_HOME is not $ORIGIN; run: verify-uvw down, then up" >&2; return 1; }
  node "$CLI_MAIN" "$@"
}

mcp_digest() {
  local context="${MCP_BUILD_CONTEXT:-$REPO}"
  git -C "$context" ls-files -co --exclude-standard -z -- "${MCP_BUILD_INPUTS[@]}" | node -e '
    const fs = require("node:fs"), crypto = require("node:crypto");
    process.chdir(process.argv[1]);
    const paths = [...new Set(fs.readFileSync(0, "utf8").split("\0").filter(Boolean))].sort();
    const hash = crypto.createHash("sha256");
    for (const path of paths) {
      if (!fs.existsSync(path)) continue;
      hash.update(path).update("\0").update(fs.readFileSync(path)).update("\0");
    }
    console.log(hash.digest("hex"));
  ' "$context"
}

mcp_compose() {
  [[ "${MCP_FROM:-image}" != dist ]] || { mcp_processes "$@"; return; }
  local executor_urls="http://executor:3000" profiles="" mode_env=()
  [[ "${MCP_RENDERER:-1}" != 1 ]] || { profiles=renderer; mode_env+=("MCP_RENDERER_URL=http://renderer:3000" "MCP_RENDERER_TOKEN=$(cat "$RUN/home/renderer-token" 2>/dev/null || echo removed)"); }
  if [[ "${MCP_PRODUCTION:-0}" == 1 ]]; then
    mode_env+=("VERIFY_UVW_MCP_NODE_ENV=production")
  else
    mode_env+=("VERIFY_UVW_MCP_NODE_ENV=development" "MCP_DEV_SESSION_PASSTHROUGH=1")
  fi
  [[ ! -f "$RUN/executor-allowed-user-ids" ]] || mode_env+=("MCP_EXECUTOR_ALLOWED_USER_IDS=$(cat "$RUN/executor-allowed-user-ids")")
  if [[ "${MCP_EXECUTORS:-1}" == 2 ]]; then
    executor_urls+=",http://executor-b:3000"
    profiles="${profiles:+$profiles,}replicas"
  fi
  COMPOSE_PROFILES="$profiles" VERIFY_UVW_EXECUTOR_URLS="$executor_urls" MCP_SYNC_BUDGET_MS="${MCP_SYNC_BUDGET_MS:-30000}" \
  VERIFY_UVW_MCP_PROJECT="$MCP_PROJECT" VERIFY_UVW_MCP_IMAGE="$MCP_IMAGE" \
    VERIFY_UVW_ORIGIN="$ORIGIN" VERIFY_UVW_SERVER_PORT="$SERVER_PORT" \
    VERIFY_UVW_MCP_PORT="$MCP_PORT" VERIFY_UVW_MCP_PUBLIC_URL="$MCP_URL" VERIFY_UVW_METRICS_TOKEN="$(cat "$RUN/home/metrics-token" 2>/dev/null || echo removed)" \
    VERIFY_UVW_MCP_STAGING_DIRECTORY="$RUN/staging" \
    VERIFY_UVW_RENDERER_TOKEN="$(cat "$RUN/home/renderer-token" 2>/dev/null || echo removed)" \
    VERIFY_UVW_EXECUTOR_TOKEN="$(cat "$RUN/home/executor-token" 2>/dev/null || echo removed)" \
    VERIFY_UVW_MCP_OAUTH_SECRET="$(cat "$RUN/home/mcp-oauth-secret" 2>/dev/null || echo removed)" \
    env -u MCP_RENDERER_URL -u MCP_RENDERER_TOKEN -u MCP_DEV_SESSION_PASSTHROUGH -u MCP_EXECUTOR_ALLOWED_USER_IDS "${mode_env[@]}" \
    docker compose -p "$MCP_PROJECT" -f "$REPO/apps/mcp/docker/compose.verify.yml" "$@"
}

# The compose commands verify-uvw uses, served by runner/mcp-processes.mjs when the roles run as local processes.
mcp_processes() {
  local verb="$1" role roles=()
  shift
  case "$verb" in
    ps) node "$MCP_PROCESSES" pid "$RUN" "${@: -1}"; return ;;
    exec) [[ "$1" != -T ]] || shift; role="$1"; shift; node "$MCP_PROCESSES" exec "$RUN" "$role" -- "$@"; return ;;
  esac
  while [[ $# -gt 0 ]]; do
    case "$1" in --wait-timeout) shift ;; -*) ;; *) roles+=("$1") ;; esac
    shift
  done
  case "$verb" in
    logs) node "$MCP_PROCESSES" logs "$RUN" ${roles[@]+"${roles[@]}"} ;;
    up) node "$MCP_PROCESSES" start "$RUN" ${roles[@]+"${roles[@]}"} ;;
    *) die "the dist start mode has no compose $verb" ;;
  esac
}

mcp_client() {
  node "$MCP_CALL" --repo "$REPO" --run "$RUN" --url "$MCP_URL" \
    --project "${MCP_PROJECT:-}" --image "${MCP_IMAGE:-}" --origin "$ORIGIN" --server-port "$SERVER_PORT" "$@"
}

mcp_tokens() {
  (umask 077 && openssl rand -hex 24 >"$RUN/home/metrics-token")
  (umask 077 && openssl rand -hex 24 >"$RUN/home/executor-token")
  (umask 077 && openssl rand -hex 24 >"$RUN/home/renderer-token")
}

mcp_up() {
  load_run
  mkdir -m 700 "$RUN/staging"
  if [[ "${MCP_FROM:-image}" == dist ]]; then
    mcp_tokens
    node "$MCP_PROCESSES" ports "$RUN" >>"$RUN/run.env" || die "cannot choose MCP role ports; run: verify-uvw down"
    node "$MCP_PROCESSES" start "$RUN" || die "MCP roles not ready; see $RUN/logs/mcp-*.log and run: verify-uvw down"
    return
  fi
  docker run --rm -v "$RUN/staging:/staging" --entrypoint sh node:24-bookworm-slim -c 'chown 1000:1000 /staging && chmod 700 /staging' >"$RUN/logs/staging-setup.log" 2>&1
  local digest
  digest="$(mcp_digest)"
  node -e 'const fs=require("node:fs"); fs.writeFileSync(process.argv[1], JSON.stringify({started_at:new Date().toISOString(),git_head:process.argv[2],source_digest:process.argv[3],image_id:null},null,2)+"\n")' \
    "$RUN/mcp-build.json" "$GIT_HEAD" "$digest"
  docker build -f "${MCP_BUILD_CONTEXT:-$REPO}/apps/mcp/Dockerfile" -t "$MCP_IMAGE" \
    --label "org.opencontainers.image.revision=$GIT_HEAD" --label "dev.univer.verify-uvw.run=$RUN_ID" "${MCP_BUILD_CONTEXT:-$REPO}" \
    >"$RUN/logs/mcp-build.log" 2>&1 \
    || { tail -n 40 "$RUN/logs/mcp-build.log" >&2; die "MCP build failed; run: verify-uvw down"; }
  MCP_IMAGE_ID="$(docker image inspect --format '{{.Id}}' "$MCP_IMAGE")"
  printf 'MCP_IMAGE_ID=%s\n' "$MCP_IMAGE_ID" >>"$RUN/run.env"
  node -e 'const fs=require("node:fs"),p=process.argv[1],v=JSON.parse(fs.readFileSync(p));v.image_id=process.argv[2];fs.writeFileSync(p,JSON.stringify(v,null,2)+"\n")' "$RUN/mcp-build.json" "$MCP_IMAGE_ID"
  mcp_tokens
  mcp_compose up -d --wait --wait-timeout 60 \
    || die "MCP gateway not ready; see compose logs and run: verify-uvw down"
  wait_http "http://127.0.0.1:$MCP_PORT/healthz" 60 || die "MCP healthz failed; run: verify-uvw down"
}

mcp_doctor() {
  local renderer_cid from="${MCP_FROM:-image}" transport="http://host.docker.internal:$SERVER_PORT"
  [[ "$from" == image ]] || transport="http://127.0.0.1:$SERVER_PORT"
  node "$REPO/.agents/skills/verify-uvw/bin/executor-doctor.mjs" "$REPO" "$RUN" "${MCP_PROJECT:-}" "${MCP_IMAGE:-}" "${MCP_IMAGE_ID:-}" "$ORIGIN" "$SERVER_PORT" "$MCP_PORT" "${MCP_EXECUTORS:-1}" "${MCP_PRODUCTION:-0}" "${MCP_RENDERER:-1}" "$from" "$transport" || bad "MCP executor checks failed"
  if [[ "${MCP_RENDERER:-1}" == 1 ]]; then
    node "$REPO/.agents/skills/verify-uvw/bin/renderer-doctor.mjs" "$REPO" "$RUN" "${MCP_PROJECT:-}" "${MCP_IMAGE:-}" "${MCP_IMAGE_ID:-}" "$ORIGIN" "$SERVER_PORT" "$MCP_PORT" "$from" "$transport" || bad "MCP renderer checks failed"
  elif renderer_cid="$(mcp_compose ps -aq renderer)" && [[ -z "$renderer_cid" ]]; then
    ok "MCP renderer disabled; renderer checks skipped and no renderer container exists"
  else bad "MCP renderer disabled but container exists"; fi
  if mcp_compose exec -T gateway node -e 'const fs=require("node:fs"),s=fs.lstatSync(process.env.MCP_STAGING_DIRECTORY);process.exit(s.isDirectory()&&s.uid===process.getuid()&&(s.mode&0o077)===0?0:1)' >/dev/null 2>&1; then
    ok "MCP staging directory is private and owned by the gateway uid"
  else bad "MCP staging directory is missing or unsafe"; fi
  local gateway_logs who auth=dev
  [[ "${MCP_PRODUCTION:-0}" != 1 ]] || auth=pat
  if [[ "$from" == dist ]]; then mcp_doctor_processes; else mcp_doctor_containers; fi
  if mcp_compose exec -T gateway node -e 'fetch(process.env.WORKSPACE_TRANSPORT_URL+"/api/session").then(r=>process.exit(r.status===200?0:1),()=>process.exit(1))' >/dev/null 2>&1; then
    ok "MCP container reaches this run's Workspace"
  else bad "MCP container cannot reach host Workspace; see local-verification section 2.1"; fi
  if [[ -f "$RUN/home/metrics-token" ]] && \
    [[ "$(curl -sS -o /dev/null -w '%{http_code}' "http://127.0.0.1:$MCP_PORT/metrics")" == 401 ]] && \
    [[ "$(curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(cat "$RUN/home/metrics-token")" "http://127.0.0.1:$MCP_PORT/metrics")" == 200 ]]; then
    ok "MCP metrics reject missing token and accept this run's token"
  else bad "MCP metrics token protection failed"; fi
  if [[ -f "$RUN/user.env" ]]; then
    if who="$(mcp_client doctor --auth "$auth" doctor-whoami whoami)" && node -e 'const v=JSON.parse(process.argv[1]);process.exit(v.subject?.name===process.argv[2]&&v.origin===process.argv[3]?0:1)' "$who" "Verify $RUN_ID" "$ORIGIN"; then
      ok "MCP whoami returns this run's user"
    else bad "MCP whoami failed: run verify-uvw user"; fi
    if [[ -s "$RUN/home/mcp-token" ]] && who="$(mcp_client doctor --auth pat doctor-pat-whoami whoami)" \
      && node -e 'const v=JSON.parse(process.argv[1]);process.exit(v.subject?.name===process.argv[2]?0:1)' "$who" "Verify $RUN_ID"; then
      ok "MCP gateway exchanged this run's PAT for a downstream session"
    else bad "MCP PAT exchange failed: run verify-uvw mcp-token, and check the gateway client in OAUTH_CLIENTS_JSON"; fi
    if gateway_logs="$(mcp_compose logs --no-color --no-log-prefix gateway 2>/dev/null)" && [[ -s "$RUN/home/mcp-session" ]]; then
      if printf '%s' "$gateway_logs" | node -e 'const fs=require("node:fs");const logs=fs.readFileSync(0,"utf8");process.exit(process.argv.slice(1).filter(p=>fs.existsSync(p)).some(p=>logs.includes(fs.readFileSync(p,"utf8").trim()))?1:0)' "$RUN/home/mcp-session" "$RUN/home/mcp-token" "$RUN/home/mcp-oauth-secret"; then
        ok "MCP gateway logs contain no session, PAT or gateway client secret"
      else bad "MCP gateway leaks session credential; blocking defect"; fi
    else bad "MCP cannot check gateway logs or session; run verify-uvw user"; fi
    if [[ ! -s "$RUN/home/mcp-token" ]]; then
      bad "MCP cannot verify Workspace server logs: run verify-uvw mcp-token"
    elif node -e 'const fs=require("node:fs");const logs=fs.readFileSync(process.argv[1],"utf8");process.exit(process.argv.slice(2).some(p=>{const secret=fs.readFileSync(p,"utf8").trim();return !secret||logs.includes(secret)})?1:0)' "$RUN/logs/server.log" "$RUN/home/mcp-token" "$RUN/home/mcp-oauth-secret"; then
      ok "Workspace server logs contain no PAT or gateway client secret"
    else bad "MCP cannot verify Workspace server logs are free of PAT and gateway client secret; blocking defect"; fi
  fi
}

# The image and its containers, which the dist start mode does not have.
mcp_doctor_containers() {
  local engine digest cid inspect mapping
  if engine="$(node "$BIN/mcp-engine.mjs")"; then
    ok "MCP container engine is $engine"
  else bad "MCP needs macOS Docker Desktop or OrbStack; found $engine"; fi
  if digest="$(mcp_digest)" && node -e 'const fs=require("node:fs");process.exit(JSON.parse(fs.readFileSync(process.argv[1])).source_digest===process.argv[2]?0:1)' "$RUN/mcp-build.json" "$digest" 2>/dev/null; then
    ok "MCP image matches build inputs"
  else bad "MCP image is stale or build record missing: down, then up"; fi
  if cid="$(mcp_compose ps -q gateway 2>/dev/null)" && [[ -n "$cid" ]] && inspect="$(docker inspect "$cid" 2>/dev/null)"; then
    if node -e 'const c=JSON.parse(process.argv[1])[0];process.exit(c.State.Running&&c.State.Health?.Status==="healthy"&&c.Image===process.argv[2]?0:1)' "$inspect" "${MCP_IMAGE_ID:-}"; then
      ok "MCP gateway is healthy and uses this run's image"
    else bad "MCP gateway state or image mismatch: down, then up"; fi
    if node -e 'const e=JSON.parse(process.argv[1])[0].Config.Env;process.exit(e.includes("WORKSPACE_ORIGIN="+process.argv[2])&&e.includes("WORKSPACE_TRANSPORT_URL=http://host.docker.internal:"+process.argv[3])?0:1)' "$inspect" "$ORIGIN" "$SERVER_PORT"; then
      ok "MCP identity origin and Workspace transport match this run"
    else bad "MCP configuration drift: down, then up"; fi
  else
    bad "MCP cannot inspect gateway: down, then up"
    bad "MCP cannot verify container configuration: down, then up"
  fi
  if mapping="$(mcp_compose port gateway 3000 2>/dev/null)" && [[ "$mapping" == "127.0.0.1:$MCP_PORT" ]] && curl -fsS -o /dev/null "http://127.0.0.1:$MCP_PORT/healthz"; then
    ok "MCP loopback port mapping and healthz match this run"
  else bad "MCP port is occupied or mapped incorrectly"; fi
}

mcp_doctor_processes() {
  local check pid
  for check in "container engine" "image digest" "gateway container health and image" "container identity origin and Workspace transport" "loopback port mapping"; do
    echo "skip  MCP $check: dist start mode has no container"
  done
  if pid="$(mcp_compose ps -q gateway)" && [[ -n "$pid" && "$(listener_pid "$MCP_PORT")" == "$pid" ]] && curl -fsS -o /dev/null "http://127.0.0.1:$MCP_PORT/healthz"; then
    ok "MCP gateway port $MCP_PORT is owned by this run's gateway (pid $pid) and healthz answers"
  else bad "MCP gateway port $MCP_PORT is not owned by this run's gateway, or healthz fails: down, then up"; fi
}

mcp_user() {
  node --input-type=module - "$RUN" "$ORIGIN" "$USERNAME" <<'JS'
import {readFileSync,writeFileSync} from 'node:fs';
const [run,origin,username]=process.argv.slice(2);
for (const [path,file] of [['/api/auth/cli/password/login','mcp-session'],['/api/auth/password/login','browser-session']]) {
  const response=await fetch(origin+path, {method:'POST',headers:{'content-type':'application/json',origin},body:JSON.stringify({username,password:readFileSync(run+'/user.pw','utf8')})});
  if (!response.ok) throw new Error(path+' returned '+response.status);
  const session=response.headers.getSetCookie().map(c=>/^workspace_session=([^;]+)/.exec(c)?.[1]).find(Boolean);
  if (!session) throw new Error(path+' returned no session cookie');
  writeFileSync(run+'/home/'+file,session,{mode:0o600});
}
JS
  [[ -s "$RUN/home/mcp-token" ]] || mcp_token >/dev/null
  if [[ "${MCP_PRODUCTION:-0}" == 1 ]]; then
    local user_id
    user_id="$(node -e 'const fs=require("node:fs");console.log(JSON.parse(fs.readFileSync(process.argv[1])).user.id)' "$RUN/logs/register.json")"
    if [[ "$(cat "$RUN/executor-allowed-user-ids")" == verify-uvw-pending-user ]]; then
      cmd_mcp_allow_users "$user_id"
    fi
  fi
  node --input-type=module - "$RUN" "$MCP_URL" <<'JS'
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {randomBytes} from 'node:crypto';
const [run,url]=process.argv.slice(2);
const token=readFileSync(run+'/home/mcp-token','utf8').trim();
const dir=run+'/home/opencode-'+randomBytes(4).toString('hex');
mkdirSync(dir,{mode:0o700});
writeFileSync(dir+'/opencode.json',JSON.stringify({$schema:'https://opencode.ai/config.json',mcp:{'verify-uvw':{type:'remote',url,enabled:true,headers:{Authorization:'Bearer '+token}}},permission:{edit:'deny',bash:'deny',webfetch:'deny'}},null,2)+'\n',{mode:0o600});
writeFileSync(run+'/home/opencode-dir',dir+'\n',{mode:0o600});
JS
}

mcp_token() { # [--scopes read,write,...] [--name name]
  [[ -s "$RUN/home/browser-session" ]] || die "no browser session; run: verify-uvw user"
  node --input-type=module - "$RUN" "$ORIGIN" "$RUN_ID" "$@" <<'JS'
import {readFileSync,writeFileSync} from 'node:fs';
const [run,origin,runId,...args]=process.argv.slice(2);
let name=`verify-uvw-${runId}`, scopes;
while (args.length) {
  const flag=args.shift(), value=args.shift();
  if (value===undefined) throw new Error(`Missing value for ${flag}`);
  if (flag==='--scopes') scopes=value.split(',').filter(Boolean);
  else if (flag==='--name') name=value;
  else throw new Error(`Unknown option ${flag}`);
}
const session=readFileSync(run+'/home/browser-session','utf8').trim();
const response=await fetch(origin+'/api/auth/tokens', {method:'POST',headers:{'content-type':'application/json',cookie:'workspace_session='+session,origin},body:JSON.stringify({name,...(scopes?{scopes}:{})})});
if (response.status!==201) throw new Error('PAT creation returned '+response.status);
const {token,record}=await response.json();
if (typeof token!=='string' || typeof record?.id!=='string') throw new Error('PAT creation returned no token');
writeFileSync(run+'/home/mcp-token',token,{mode:0o600});
writeFileSync(run+'/home/mcp-token-id',record.id,{mode:0o600});
console.log(record.id);
JS
}

mcp_down() {
  if [[ "${MCP_FROM:-image}" == dist ]]; then
    local clean=1
    # The roles already write logs/mcp-<role>.log, so stopping them keeps their logs.
    node "$MCP_PROCESSES" stop "$RUN" || clean=0
    rm -rf "$RUN/staging"
    [[ ! -e "$RUN/staging" ]] || { clean=0; echo "warning: staging directory remains" >&2; }
    [[ "$clean" != 1 ]] || echo "ok    MCP resources removed"
    return
  fi
  mcp_compose logs --no-color --timestamps gateway >"$RUN/logs/mcp-gateway.log" 2>&1 || echo "warning: cannot save MCP logs" >&2
  mcp_compose logs --no-color --timestamps executor executor-b >"$RUN/logs/mcp-executor.log" 2>&1 || echo "warning: cannot save executor logs" >&2
  mcp_compose logs --no-color --timestamps renderer >"$RUN/logs/mcp-renderer.log" 2>&1 || echo "warning: cannot save renderer logs" >&2
  mcp_compose down --volumes --remove-orphans || echo "warning: MCP compose down failed; retry down" >&2
  if docker image inspect "$MCP_IMAGE" >/dev/null 2>&1; then
    docker image rm "$MCP_IMAGE" || echo "warning: cannot remove MCP image $MCP_IMAGE" >&2
  fi
  local kind remaining resource clean=1
  for kind in container network volume; do
    if remaining="$(docker "$kind" ls -q --filter "label=com.docker.compose.project=$MCP_PROJECT" 2>/dev/null)"; then
      if [[ -n "$remaining" ]]; then
        clean=0
        while IFS= read -r resource; do
          echo "warning: remaining MCP $kind $resource; remove with docker $kind rm $resource" >&2
        done <<<"$remaining"
      fi
    else clean=0; echo "warning: cannot list MCP $kind resources" >&2; fi
  done
  if remaining="$(docker image ls -q "$MCP_IMAGE" 2>/dev/null)"; then
    if [[ -n "$remaining" ]]; then clean=0; echo "warning: remaining MCP image $MCP_IMAGE; remove with docker image rm $MCP_IMAGE" >&2; fi
  else clean=0; echo "warning: cannot list MCP image" >&2; fi
  rm -rf "$RUN/staging"
  [[ ! -e "$RUN/staging" ]] || { clean=0; echo "warning: staging directory remains" >&2; }
  [[ "$clean" != 1 ]] || echo "ok    MCP resources removed"
}

cmd_mcp() {
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  mcp_client "$@"
}

cmd_renderer_call() { # label op, with the operation input as JSON on stdin
  [[ $# -eq 2 && "$1" =~ ^[A-Za-z0-9._-]{1,64}$ && "$2" =~ ^(screenshot|printPdf|lint|measureText)$ ]] || die "usage: verify-uvw renderer-call <label> screenshot|printPdf|lint|measureText < input.json"
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  [[ "${MCP_RENDERER:-1}" == 1 ]] || die "renderer disabled for this run"
  local base="$RUN/evidence/$1" bin="$REPO/.agents/skills/verify-uvw/bin"
  printf 'renderer-call %s\n' "$2" >"$base.cmd"
  mcp_compose exec -T executor node --input-type=module -e "$(cat "$bin/renderer-call.mjs")" "$2" | node "$bin/renderer-save.mjs" "$base"
}

cmd_renderer_restart() { # [max-runtimes]: recreate only this run's renderer, optionally with another RENDERER_MAX_RUNTIMES
  [[ $# -le 1 && "${1:-2}" =~ ^[1-9][0-9]?$ ]] || die "usage: verify-uvw renderer-restart [max-runtimes]"
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  [[ "${MCP_RENDERER:-1}" == 1 ]] || die "renderer disabled for this run"
  RENDERER_MAX_RUNTIMES="${1:-2}" mcp_compose up -d --force-recreate --no-deps --wait renderer >/dev/null 2>&1 || die "renderer did not become healthy"
  local i
  for ((i = 0; i < 60; i++)); do
    mcp_compose logs --no-log-prefix renderer 2>&1 | grep -q 'Renderer runtime warmed' && { echo "renderer restarted with RENDERER_MAX_RUNTIMES=${1:-2}, first runtime warm"; return 0; }
    sleep 1
  done
  die "renderer did not warm its first runtime within 60 s"
}

cmd_mcp_allow_users() {
  [[ $# -gt 0 ]] || die "usage: verify-uvw mcp-allow-users <user-id>... | '*' | workspace"
  local id
  if [[ $# -ne 1 || "$1" != '*' ]]; then
    for id in "$@"; do
      [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "user IDs must contain only letters, digits, underscores or hyphens; '*' must be the only argument"
    done
  fi
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run"
  (IFS=,; printf '%s\n' "$*") >"$RUN/executor-allowed-user-ids"
  local services=(executor)
  [[ "${MCP_EXECUTORS:-1}" != 2 ]] || services+=(executor-b)
  mcp_compose up -d --force-recreate --no-deps --wait --wait-timeout 60 "${services[@]}" \
    || die "allowlist saved but MCP restart failed; retry mcp-allow-users"
  cmd_mcp_gateway_restart
  echo "MCP executor allowlist updated; only gateway and executor(s) recreated"
}

cmd_mcp_gateway_restart() {
  [[ $# -eq 0 ]] || die "usage: verify-uvw mcp-gateway-restart"
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run"
  mcp_compose up -d --force-recreate --no-deps --wait --wait-timeout 60 gateway \
    || die "MCP gateway restart failed"
}

cmd_mcp_token() {
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  mcp_token "$@"
}

cmd_principal() { # name [label]: a new agent principal whose token never leaves home/
  [[ $# -ge 1 && $# -le 2 && "$1" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ && "$1" != human ]] \
    || die "usage: verify-uvw principal <name> [label]  (name: a-z, 0-9, _ and -, not human)"
  load_run
  [[ ! -e "$RUN/home/principals/$1.token" ]] || die "principal $1 already exists in this run"
  VERIFY_UVW_AGENT_LIMIT_REASON="$(agent_limit_reason)" node --input-type=module - "$RUN" "$ORIGIN" "$@" <<'JS'
import {mkdirSync,writeFileSync} from 'node:fs';
const [run,origin,name,label]=process.argv.slice(2);
const fail=message=>{ console.error('verify-uvw: '+message); process.exit(1); };
const response=await fetch(origin+'/api/agents',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(label===undefined?{}:{label})});
if (response.status===429) fail(process.env.VERIFY_UVW_AGENT_LIMIT_REASON);
const body=await response.json().catch(()=>null);
if (response.status!==201 || typeof body?.token!=='string' || typeof body.agent?.id!=='string') fail('POST /api/agents returned '+response.status);
mkdirSync(run+'/home/principals',{recursive:true,mode:0o700});
writeFileSync(`${run}/home/principals/${name}.token`,body.token,{mode:0o600});
writeFileSync(`${run}/home/principals/${name}.id`,body.agent.id,{mode:0o600});
writeFileSync(`${run}/evidence/principal-${name}.json`,JSON.stringify({name,agent:body.agent,mcpUrl:body.mcpUrl,expiresAt:body.expiresAt},null,2)+'\n');
console.log(`id:       ${body.agent.id}\nusername: ${body.agent.username}`);
JS
}

cmd_secret_check() { # [directory]: fails when evidence holds a token, a session cookie or one of this run's secrets
  [[ $# -le 1 ]] || die "usage: verify-uvw secret-check [directory]"
  load_run
  node "$BIN/secrets.mjs" check "$RUN" "${1:-$RUN/evidence}"
}

cmd_story() { # [--as identity] [--oauth] [--model id[#effort]] label mcp|uvw|codex prompt: one recorded run
  load_run
  local USERNAME="" mcp_url=""
  # shellcheck disable=SC1091
  [[ ! -f "$RUN/user.env" ]] || source "$RUN/user.env"
  [[ "${MCP_ENABLED:-0}" != 1 ]] || mcp_url="$MCP_URL"
  VERIFY_UVW_AGENT_LIMIT_REASON="$(agent_limit_reason)" node "$BIN/story.mjs" "$REPO" "$RUN" "$ORIGIN" "$mcp_url" "$USERNAME" "$OPENCODE_MODEL" "$@"
}

cmd_open_anon() { # label url: what a visitor with no cookies sees
  [[ $# -eq 2 && "$1" =~ ^[A-Za-z0-9._-]{1,64}$ && "$2" =~ ^https?://[^/]+ ]] || die "usage: verify-uvw open-anon <label> <url>"
  local origin="${BASH_REMATCH[0]}" url="$2"
  load_run
  local base="$RUN/evidence/$1" status
  # A session of its own, closed first, starts with no cookies and leaves the run's browser signed in.
  export AGENT_BROWSER_SESSION="verify-uvw-$RUN_ID-anon-$1"
  agent-browser close >/dev/null 2>&1 || true
  printf 'open-anon %q\n' "$url" >"$base.cmd"
  agent-browser set viewport 1440 900 >/dev/null
  agent-browser open about:blank >/dev/null
  agent-browser cookies clear >/dev/null
  agent-browser record start "$base.webm" >/dev/null
  agent-browser open "$url" >/dev/null
  agent-browser wait 8000 >/dev/null
  agent-browser screenshot "$base.png" >/dev/null
  agent-browser get text body | node "$BIN/secrets.mjs" redact "$RUN" >"$base.page.txt"
  agent-browser record stop >/dev/null
  agent-browser close >/dev/null
  if command -v ffmpeg >/dev/null; then
    ffmpeg -y -loglevel error -i "$base.webm" -pix_fmt yuv420p -movflags +faststart "$base.mp4" </dev/null || echo "warning: ffmpeg could not write $base.mp4" >&2
  fi
  if [[ "$url" =~ /nodes/([A-Za-z0-9-]+) ]]; then
    status="$(curl -sS -o /dev/null -w '%{http_code}' "$origin/api/nodes/${BASH_REMATCH[1]}")"
    printf 'GET /api/nodes/%s without credentials -> %s\n' "${BASH_REMATCH[1]}" "$status" | tee "$base.node-status"
  fi
  echo "[evidence $base.{png,webm,mp4,page.txt}]" >&2
}

cmd_agent_up() {
  load_run
  [[ -n "${AGENT_PORT:-}" ]] || die "no Agent callback registered; start up with VERIFY_UVW_AGENT_PORT"
  [[ -z "$(listener_pid "$AGENT_PORT")" ]] || die "Agent port $AGENT_PORT is occupied"
  if [[ -f "$RUN/agent.pid" ]] && kill -0 "$(cat "$RUN/agent.pid")" 2>/dev/null; then
    die "Agent already started; run: verify-uvw agent-down"
  fi
  echo "installing disposable Agent; see $RUN/logs/agent-install.log"
  (
    set -e
    umask 077
    export HOME="$RUN/home" XDG_CACHE_HOME="$RUN/home/.cache" npm_config_cache="$RUN/home/.npm"
    export PNPM_CONFIG_STORE_DIR="$RUN/home/.pnpm-store" PNPM_CONFIG_CACHE_DIR="$RUN/home/.cache/pnpm"
    export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
    export UWH_LOCAL_ROOT="$RUN/home/agent"
    export UWH_DSH_BOOTSTRAP="$UWH_LOCAL_ROOT/dsh-cli" DSH_HOME="$UWH_LOCAL_ROOT/install"
    export UWH_DSH_DATA_HOME="$UWH_LOCAL_ROOT/data"
    export DSH_BIN="$UWH_DSH_BOOTSTRAP/node_modules/@deepseek-ai/dsh/lib/bin.js"
    export DSH_PROFILE=univer-workspace-harness
    mkdir -p "$UWH_LOCAL_ROOT/runtime" "$DSH_HOME/internal-packages"
    export UWA_PACKAGES="$(mktemp -d "$DSH_HOME/internal-packages/build.XXXXXX")"
    cd "$REPO"
    [[ "$(pnpm config get store-dir)" == "$PNPM_CONFIG_STORE_DIR" ]] || die "pnpm must use this run's package store"
    # Install the pinned nested workspace in the run, keeping its modules and lockfile disposable.
    cp packages/dsh-runtime/{package.json,pnpm-lock.yaml,pnpm-workspace.yaml} "$UWH_LOCAL_ROOT/runtime/"
    pnpm --dir "$UWH_LOCAL_ROOT/runtime" install --frozen-lockfile
    pnpm --dir "$UWH_LOCAL_ROOT/runtime" deploy --legacy --filter @univerjs/univer-workspace-dsh-runtime \
      --prod --config.node-linker=hoisted "$UWH_DSH_BOOTSTRAP"
    pnpm --filter @univerjs/univer-workspace-client-core build
    pnpm --filter @univerjs/workspace-agent build
    pnpm --filter dsh-univer-workspace-plugin build
    pnpm --filter dsh-univer-workspace-skin-plugin build
    for package in @univerjs/workspace-agent dsh-univer-workspace-plugin dsh-univer-workspace-skin-plugin; do
      pnpm --filter "$package" pack --pack-destination "$UWA_PACKAGES"
    done
    export DSH_PLUGINS="file:$UWA_PACKAGES/univerjs-workspace-agent-0.1.0.tgz file:$UWA_PACKAGES/dsh-univer-workspace-plugin-0.1.0.tgz file:$UWA_PACKAGES/dsh-univer-workspace-skin-plugin-0.1.0.tgz"
    NPM_CONFIG_USERCONFIG="$REPO/.npmrc" ./apps/agent/scripts/build-profile.sh
  ) >"$RUN/logs/agent-install.log" 2>&1 || die "Agent installation failed; see $RUN/logs/agent-install.log; run down"
  # start-local clears the unconnected child's origin env; seed its configured origin without a session.
  (umask 077; mkdir -p "$RUN/home/agent/data"
    if [[ ! -f "$RUN/home/agent/data/connection.json" ]]; then
      printf '{"version":1,"configuredOrigin":"%s"}\n' "$ORIGIN" >"$RUN/home/agent/data/connection.json"
    fi)
  rm -f "$RUN/home/agent-url"
  (
    umask 077
    cd "$REPO"
    exec nohup env -i PATH="$PATH" HOME="$RUN/home" XDG_CACHE_HOME="$RUN/home/.cache" \
      DSH_HOME="$RUN/home/agent/install" DSH_PROFILE=univer-workspace-harness \
      DSH_BIN="$RUN/home/agent/dsh-cli/node_modules/@deepseek-ai/dsh/lib/bin.js" \
      UWH_DSH_DATA_HOME="$RUN/home/agent/data" UWH_WORKSPACE_ORIGIN="$ORIGIN" \
      node apps/agent/scripts/start-local.mjs --port "$AGENT_PORT" --no-open --trusted-host 127.0.0.1 \
      >"$RUN/home/agent-log.private" 2>&1
  ) &
  local pid=$! i
  printf '%s\n' "$pid" >"$RUN/agent.pid"
  for ((i = 0; i < 120; i++)); do
    kill -0 "$pid" 2>/dev/null || die "Agent exited; see $RUN/home/agent-log.private; run down"
    if node - "$RUN" "$AGENT_PORT" <<'JS'
const fs = require('node:fs'), [run,port] = process.argv.slice(2);
const log = fs.readFileSync(run+'/home/agent-log.private','utf8');
const url = log.match(/dsh web: (http:\/\/127\.0\.0\.1:[0-9]+\/\?token=[^\s]+)/)?.[1];
if (!url || new URL(url).port !== port) process.exit(1);
fs.writeFileSync(run+'/home/agent-url',url+'\n',{mode:0o600});
JS
    then
      if [[ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$AGENT_PORT/")" == 401 ]]; then
        echo "ok    Agent answers on 127.0.0.1:$AGENT_PORT (pid $pid); private URL: $RUN/home/agent-url"
        return 0
      fi
    fi
    sleep 1
  done
  die "Agent not ready after 120 seconds; see $RUN/home/agent-log.private; run down"
}

cmd_agent_down() {
  load_run
  if [[ -f "$RUN/agent.pid" ]]; then
    stop_pid "$(cat "$RUN/agent.pid")" "apps/agent/scripts/start-local.mjs --port ${AGENT_PORT:?}"
    rm -f "$RUN/agent.pid"
  fi
}

mcp_dist_fresh() {
  [[ -f "$REPO/apps/mcp/dist/main.js" && -z "$(find "$REPO/apps/mcp/src" -newer "$REPO/apps/mcp/dist/main.js" -type f -print -quit)" ]]
}

cmd_up() {
  local usage="usage: verify-uvw up [--reuse] [--for <feature> [journey-id|mode...]]" reuse="" mode_env line
  [[ "${1:-}" != --reuse ]] || { reuse=1; shift; }
  if [[ "${1:-}" == --for ]]; then
    shift
    [[ $# -ge 1 ]] || die "$usage"
    # The journeys' declared mode wins over these flags in the caller's environment.
    mode_env="$(node "$BIN/journeys.mjs" up-env "$@")" || exit $?
    while IFS= read -r line; do export "$line"; done <<<"$mode_env"
    set --
  fi
  [[ $# == 0 ]] || die "$usage"
  local mcp_from="${VERIFY_UVW_MCP_FROM:-image}"
  [[ "$mcp_from" == image || "$mcp_from" == dist ]] || die "VERIFY_UVW_MCP_FROM must be image or dist"
  [[ "$mcp_from" == image || "${VERIFY_UVW_RUNNER:-0}" == 1 ]] || die "the dist start mode runs only inside the verify runner"
  deps_fresh || die "node_modules is older than pnpm-lock.yaml; run: pnpm install --frozen-lockfile"
  cli_fresh || die "CLI build is stale; run: pnpm --filter 'univer-workspace-cli...' build"
  local server_port="${VERIFY_UVW_SERVER_PORT:-3920}" web_port="${VERIFY_UVW_WEB_PORT:-5973}"
  local port
  for port in "$server_port" "$web_port"; do
    [[ -z "$(listener_pid "$port")" ]] || die "port $port is already in use; not driving an instance this run did not start"
  done

  [[ "${VERIFY_UVW_MCP_RENDERER:-1}" =~ ^[01]$ && "${VERIFY_UVW_MCP_PRODUCTION:-0}" =~ ^[01]$ ]] || die "MCP renderer and production flags must be 0 or 1"
  [[ "${VERIFY_UVW_MCP_EXECUTORS:-1}" =~ ^[12]$ ]] || die "VERIFY_UVW_MCP_EXECUTORS must be 1 or 2"
  # Journeys create many agents, so a run lifts the production default of 5 agent creations per source IP per hour.
  local agent_limit="${VERIFY_UVW_AGENT_CREATE_LIMIT:-100}"
  [[ "$agent_limit" =~ ^[0-9]+$ ]] || die "VERIFY_UVW_AGENT_CREATE_LIMIT must be a non-negative integer"
  local id="${VERIFY_UVW_RUN:-$(date +%Y%m%d-%H%M%S)}"
  local mcp_enabled=0 mcp_port="${VERIFY_UVW_MCP_PORT:-3930}" mcp_public_url engine
  if [[ "${VERIFY_UVW_MCP:-0}" == 1 ]]; then
    mcp_enabled=1
    [[ "$id" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "MCP run id must match ^[a-z0-9][a-z0-9_-]*$; choose VERIFY_UVW_RUN"
    if [[ "$mcp_from" == image ]]; then
      engine="$(node "$BIN/mcp-engine.mjs")" || die "MCP verification requires macOS Docker Desktop or OrbStack; found $engine"
    else
      mcp_dist_fresh || die "MCP build is stale; run: pnpm --filter '@univerjs/univer-workspace-mcp...' build"
    fi
    [[ "$mcp_port" =~ ^[0-9]+$ && "$mcp_port" -ge 1 && "$mcp_port" -le 65535 ]] || die "choose VERIFY_UVW_MCP_PORT between 1 and 65535"
    [[ "$mcp_port" != "$server_port" && "$mcp_port" != "$web_port" && -z "$(listener_pid "$mcp_port")" ]] || die "MCP port $mcp_port is occupied; choose VERIFY_UVW_MCP_PORT"
  fi
  local run="$ROOT/$id"
  if [[ -e "$run" ]]; then
    [[ -n "$reuse" && -f "$run/run.env" && ! -d "$run/data" && ! -d "$run/home" ]] \
      || die "$run already exists; down first, then up --reuse to retain evidence"
    [[ ! -f "$run/user.env" ]] || unlink "$run/user.env"
  fi
  local agent_port="${VERIFY_UVW_AGENT_PORT:-}" server_oauth_env=()
  if [[ -n "$agent_port" ]]; then
    [[ "$agent_port" =~ ^[0-9]+$ && "$agent_port" -ge 1 && "$agent_port" -le 65535 ]] || die "choose VERIFY_UVW_AGENT_PORT between 1 and 65535"
    [[ "$agent_port" != "$server_port" && "$agent_port" != "$web_port" && ( "$mcp_enabled" != 1 || "$agent_port" != "$mcp_port" ) && -z "$(listener_pid "$agent_port")" ]] || die "Agent port $agent_port is occupied or shared with this run"
  fi
  mkdir -p "$run"/{data,home}
  # The verify runner points this at a host mount, so evidence and logs leave its container as they are written.
  if [[ -n "${VERIFY_UVW_EVIDENCE_ROOT:-}" ]]; then
    local kept="$VERIFY_UVW_EVIDENCE_ROOT/$id" d
    mkdir -p "$kept"/{logs,evidence}
    for d in logs evidence; do [[ -e "$run/$d" ]] || ln -s "$kept/$d" "$run/$d"; done
  else
    mkdir -p "$run"/{logs,evidence}
  fi
  (umask 077 && openssl rand -hex 24 >"$run/home/workspace-metrics-token")
  if [[ "$mcp_enabled" == 1 ]]; then
    (umask 077 && openssl rand -hex 24 >"$run/home/mcp-oauth-secret")
    mcp_public_url="http://127.0.0.1:$mcp_port/mcp"
    # Same-origin mode serves the gateway at the Vite origin, as production serves it beside the Browser.
    [[ "${VERIFY_UVW_MCP_SAME_ORIGIN:-0}" != 1 ]] || mcp_public_url="http://127.0.0.1:$web_port/mcp"
    server_oauth_env=("MCP_RESOURCE_URLS=$mcp_public_url" "PUBLIC_ORIGIN=http://127.0.0.1:$web_port" "MCP_CIMD_ENABLED=${MCP_CIMD_ENABLED:-1}")
    if node --input-type=module -e 'import { lookup } from "node:dns/promises"; const addresses = await lookup("claude.ai", {all:true}).catch(() => []); process.exit(addresses.some(({address}) => /^198\.(18|19)\./.test(address)) ? 0 : 1)'; then
      server_oauth_env+=("MCP_CIMD_EXEMPT_NETWORKS=198.18.0.0/15")
      echo "CIMD: claude.ai resolves to fake-IP; Workspace Server only exempts 198.18.0.0/15"
    fi
  fi
  # The gateway's confidential client with MCP, and the Workspace Agent's public client when VERIFY_UVW_AGENT_PORT names its port.
  server_oauth_env+=("OAUTH_CLIENTS_JSON=$(node -e 'const [secretFile,agentPort]=process.argv.slice(1),fs=require("node:fs"),clients=[];
if (fs.existsSync(secretFile)) clients.push({clientId:"univer-workspace-mcp-gateway",clientType:"confidential",clientSecret:fs.readFileSync(secretFile,"utf8").trim(),tokenExchange:true,redirectUris:["http://127.0.0.1/unused"],scopes:["identity"]});
if (agentPort) clients.push({clientId:"univer-workspace-harness",clientType:"public",requiresConsent:true,redirectUris:[`http://127.0.0.1:${agentPort}/auth/oauth/callback`],scopes:["identity","session"]});
console.log(clients.length ? JSON.stringify({clients}) : "")' "$run/home/mcp-oauth-secret" "$agent_port")")

  # env -i keeps the developer's shell and apps/workspace/.env (OAuth, data paths) out of this instance.
  (cd "$WORKSPACE_APP" && exec nohup env -i PATH="$PATH" HOME="$HOME" \
    HOST=127.0.0.1 PORT="$server_port" LOG_LEVEL=info SECURE_COOKIES=false AGENT_CREATE_LIMIT_PER_HOUR="$agent_limit" \
    METRICS_TOKEN="$(cat "$run/home/workspace-metrics-token")" \
    "${server_oauth_env[@]}" \
    DATABASE_FILE="$run/data/univer-workspace.sqlite" \
    COLLABORATION_DATABASE_FILE="$run/data/univer-collaboration.sqlite" \
    BLOB_DIRECTORY="$run/data/blobs" \
    node --import tsx server/src/main.ts >"$run/logs/server.log" 2>&1) &
  local server_pid=$!
  (cd "$WORKSPACE_APP" && exec nohup env -i PATH="$PATH" HOME="$HOME" WORKSPACE_DEV_API_PORT="$server_port" WORKSPACE_DEV_MCP_PORT="$mcp_port" \
    node node_modules/vite/bin/vite.js --host 127.0.0.1 --port "$web_port" --strictPort \
    >"$run/logs/web.log" 2>&1) &
  local web_pid=$!

  cat >"$run/run.env" <<EOF
RUN_ID=$id
SERVER_PORT=$server_port
WEB_PORT=$web_port
AGENT_PORT=$agent_port
AGENT_CREATE_LIMIT=$agent_limit
SERVER_PID=$server_pid
WEB_PID=$web_pid
GIT_HEAD=$(git -C "$REPO" rev-parse HEAD)
EOF
  printf 'MCP_ENABLED=%s\n' "$mcp_enabled" >>"$run/run.env"
  if [[ "$mcp_enabled" == 1 ]]; then
    printf 'MCP_RENDERER=%s\nMCP_PRODUCTION=%s\nMCP_SAME_ORIGIN=%s\nMCP_SYNC_BUDGET_MS=%s\n' "${VERIFY_UVW_MCP_RENDERER:-1}" "${VERIFY_UVW_MCP_PRODUCTION:-0}" "${VERIFY_UVW_MCP_SAME_ORIGIN:-0}" "${MCP_SYNC_BUDGET_MS:-30000}" >>"$run/run.env"
    [[ ! -f "$run/executor-allowed-user-ids" ]] || unlink "$run/executor-allowed-user-ids"
    [[ "${VERIFY_UVW_MCP_PRODUCTION:-0}" != 1 ]] || printf 'verify-uvw-pending-user\n' >"$run/executor-allowed-user-ids"
    [[ -z "${VERIFY_UVW_MCP_BUILD_CONTEXT:-}" ]] || printf 'MCP_BUILD_CONTEXT=%s\n' "$(cd "$VERIFY_UVW_MCP_BUILD_CONTEXT" && pwd)" >>"$run/run.env"
    if [[ "$mcp_from" == dist ]]; then
      printf 'MCP_FROM=dist\nMCP_PORT=%s\nMCP_PUBLIC_URL=%s\nMCP_EXECUTORS=%s\n' "$mcp_port" "$mcp_public_url" "${VERIFY_UVW_MCP_EXECUTORS:-1}" >>"$run/run.env"
    else
      printf 'MCP_PORT=%s\nMCP_PUBLIC_URL=%s\nMCP_PROJECT=verify-uvw-%s\nMCP_IMAGE=univer-workspace-mcp:verify-%s\nMCP_EXECUTORS=%s\n' "$mcp_port" "$mcp_public_url" "$id" "$id" "${VERIFY_UVW_MCP_EXECUTORS:-1}" >>"$run/run.env"
    fi
  fi
  ln -sfn "$run" "$ROOT/current"
  UNIVER_HOME="$run/home" node "$CLI_MAIN" config set workspace.origin "http://127.0.0.1:$web_port" >/dev/null \
    || die "cannot set workspace.origin in $run/home; run: verify-uvw down"

  wait_http "http://127.0.0.1:$server_port/api/session" 120 \
    || { tail -n 40 "$run/logs/server.log" >&2; die "server not ready; see $run/logs/server.log (run: verify-uvw down)"; }
  wait_http "http://127.0.0.1:$web_port/api/session" 60 \
    || { tail -n 40 "$run/logs/web.log" >&2; die "web not ready; see $run/logs/web.log (run: verify-uvw down)"; }
  [[ "$mcp_enabled" != 1 ]] || mcp_up
  echo "run:      $id"
  echo "web:      http://127.0.0.1:$web_port"
  echo "server:   http://127.0.0.1:$server_port"
  [[ "$mcp_enabled" != 1 ]] || echo "mcp:      $mcp_public_url"
  echo "evidence: $run/evidence"
}

cmd_doctor() {
  local fail=0
  ok() { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }
  deps_fresh && ok "node_modules matches pnpm-lock.yaml" \
    || bad "node_modules is stale: pnpm install --frozen-lockfile, then restart the run"
  cli_fresh && ok "CLI build is newer than apps/cli/src and packages/client-core/src" \
    || bad "CLI build is stale: pnpm --filter 'univer-workspace-cli...' build"
  load_run
  ok "run $RUN_ID at $RUN"
  local name pid port
  for name in SERVER WEB; do
    pid="${name}_PID"; pid="${!pid}"; port="${name}_PORT"; port="${!port}"
    if ! kill -0 "$pid" 2>/dev/null; then bad "$name pid $pid is not running"; continue; fi
    [[ "$(listener_pid "$port")" == "$pid" ]] && ok "$name port $port is owned by this run (pid $pid)" \
      || bad "$name port $port is owned by pid '$(listener_pid "$port")', not this run's $pid"
  done
  lsof -p "$SERVER_PID" 2>/dev/null | grep -F "$RUN/data/univer-workspace.sqlite" > /dev/null \
    && ok "server has this run's product database open" \
    || bad "server does not have $RUN/data/univer-workspace.sqlite open"
  curl -fsS -o /dev/null "$ORIGIN/api/session" && ok "$ORIGIN/api/session answers through the web proxy" \
    || bad "$ORIGIN/api/session does not answer"
  [[ "$(git -C "$REPO" rev-parse HEAD)" == "$GIT_HEAD" ]] && ok "HEAD unchanged since launch" \
    || bad "HEAD moved since launch; the server does not reload: down, then up"
  if [[ -f "$RUN/user.env" ]]; then
    # shellcheck disable=SC1091
    source "$RUN/user.env"
    uvw_raw auth status --json 2>/dev/null | grep -q "\"name\": \"Verify $RUN_ID\"" \
      && ok "uvw is signed in to $ORIGIN as $USERNAME (UNIVER_HOME=$UNIVER_HOME)" \
      || bad "uvw is not signed in as $USERNAME; run: verify-uvw user"
  else
    echo "info  no disposable user yet; run: verify-uvw user"
  fi
  [[ "${MCP_ENABLED:-0}" != 1 ]] || mcp_doctor
  echo "info  $(verifier_status)"
  return "$fail"
}

cmd_user() {
  load_run
  if [[ ! -f "$RUN/user.env" ]]; then
    local username="${1:-verify-$RUN_ID}"
    local password
    password="$(openssl rand -hex 16)"
    local status
    status="$(curl -sS -o "$RUN/logs/register.json" -w '%{http_code}' -X POST "$ORIGIN/api/auth/password/register" \
      -H 'content-type: application/json' \
      -d "{\"username\":\"$username\",\"displayName\":\"Verify $RUN_ID\",\"password\":\"$password\"}")"
    [[ "$status" == 201 ]] || die "register returned $status: $(cat "$RUN/logs/register.json")"
    (umask 077 && printf '%s' "$password" >"$RUN/user.pw")
    printf 'USERNAME=%s\n' "$username" >"$RUN/user.env"
  fi
  # shellcheck disable=SC1091
  source "$RUN/user.env"
  uvw_raw auth login --username "$USERNAME" --password-stdin --json <"$RUN/user.pw"
  if [[ "${MCP_ENABLED:-0}" == 1 ]]; then
    mcp_user
  fi
  echo "username: $USERNAME"
  echo "password: $RUN/user.pw"
}

cmd_mcp_oauth() {
  load_run
  [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run; start with VERIFY_UVW_MCP=1"
  local USERNAME=""
  # shellcheck disable=SC1091
  [[ ! -f "$RUN/user.env" ]] || source "$RUN/user.env"
  AGENT_BROWSER_SESSION="$AGENT_BROWSER_SESSION" VERIFY_UVW_AGENT_LIMIT_REASON="$(agent_limit_reason)" node "$BIN/mcp-oauth.mjs" "$RUN" "$ORIGIN" "$MCP_URL" "$USERNAME" "$@"
}

cmd_env() {
  load_run
  cat <<EOF
export VERIFY_UVW_RUN=$RUN_ID
export RUN=$RUN
export UNIVER_HOME=$UNIVER_HOME
export AGENT_BROWSER_SESSION=$AGENT_BROWSER_SESSION
export ORIGIN=$ORIGIN
export EVIDENCE=$RUN/evidence
EOF
  if [[ "${MCP_ENABLED:-0}" == 1 ]]; then
    cat <<EOF
export MCP_URL=$MCP_URL
export MCP_PROJECT=${MCP_PROJECT:-}
export MCP_IMAGE=${MCP_IMAGE:-}
export MCP_OPENCODE_DIR=$(cat "$RUN/home/opencode-dir" 2>/dev/null || true)
export MCP_OPENCODE_MODEL=$OPENCODE_MODEL
# opencode: (cd "\$MCP_OPENCODE_DIR" && opencode run --format json -m "\$MCP_OPENCODE_MODEL" "<prompt>" < /dev/null)
EOF
  fi
}

cmd_brief() { # feature [journey-id|mode...]: the text to hand an agent that drives a run, from journeys.mjs
  [[ $# -ge 1 ]] || die "usage: verify-uvw brief <feature> [journey-id|mode...]"
  load_run
  node "$BIN/journeys.mjs" brief --repo "$REPO" --root "$ROOT" --run-id "$RUN_ID" "$@"
}

verifier_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/verify-uvw/verifier"; }

# Sets VERIFIER_SOURCE and the parsed spec from VERIFY_UVW_VERIFIER, else from the developer's config file.
load_verifier() {
  local spec="${VERIFY_UVW_VERIFIER:-}"
  VERIFIER_SOURCE=VERIFY_UVW_VERIFIER
  if [[ -z "$spec" ]]; then
    VERIFIER_SOURCE="$(verifier_file)"
    [[ ! -f "$VERIFIER_SOURCE" ]] || spec="$(grep -v -m1 -e '^#' -e '^[[:space:]]*$' "$VERIFIER_SOURCE" || true)"
  fi
  parse_spec "$spec"
}

# [NAME=VALUE...] <kind> [agent args...]: env for the verifier's pane only, a herdr agent kind, and that agent's arguments.
# shortcut: words split on whitespace, so no value or argument can hold a space; parse shell quoting if one must.
parse_spec() {
  local words word
  read -r -a words <<<"$1"
  VERIFIER_ENV=() VERIFIER_KIND="" VERIFIER_ARGS=()
  for word in ${words[@]+"${words[@]}"}; do
    if [[ -n "$VERIFIER_KIND" ]]; then VERIFIER_ARGS+=("$word")
    elif [[ "$word" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then VERIFIER_ENV+=("$word")
    else VERIFIER_KIND="$word"; fi
  done
  [[ -n "$VERIFIER_KIND" ]]
}

# The only form of a spec the helper prints: an env value may hold an API key, so only its name shows.
verifier_display() {
  local text="$VERIFIER_KIND" names=() pair
  for pair in ${VERIFIER_ENV[@]+"${VERIFIER_ENV[@]}"}; do names+=("${pair%%=*}"); done
  [[ ${#VERIFIER_ARGS[@]} -eq 0 ]] || text+=" ${VERIFIER_ARGS[*]}"
  [[ ${#names[@]} -eq 0 ]] || text+=" (env ${names[*]})"
  echo "$text from $VERIFIER_SOURCE"
}

verifier_status() {
  load_verifier || { echo "verifier: none"; return 1; }
  local line="verifier: $(verifier_display)"
  [[ "${HERDR_ENV:-}" == 1 ]] || line+="; outside a herdr pane, delegate refuses"
  echo "$line"
}

# Opens a tab with the spec's env, without moving focus, and sets PANE and AGENT. The tab label is vu:<run> and the
# agent name starts with the run because herdr's sidebar cuts both to about 12 characters. The pane suffix keeps names
# unique, as the run lock and the evidence file names need.
verifier_pane() { # tab-label name-stem
  local tab=(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$REPO" --label "$1" --no-focus) pair out ids
  for pair in ${VERIFIER_ENV[@]+"${VERIFIER_ENV[@]}"}; do tab+=(--env "$pair"); done
  out="$("${tab[@]}")" || die "herdr could not open a tab"
  # herdr agent names match [a-z][a-z0-9_-]{0,31}.
  ids="$(node -e '
    const pane = JSON.parse(process.argv[1]).result.root_pane.pane_id, local = pane.split(":").pop().toLowerCase();
    let stem = process.argv[2].toLowerCase().replace(/[^a-z0-9_-]+/g, "-");
    if (!/^[a-z]/.test(stem)) stem = `v${stem}`;
    console.log(pane, `${stem.slice(0, 31 - local.length).replace(/[-_]+$/, "")}-${local}`);' "$out" "$2")"
  PANE="${ids% *}" AGENT="${ids#* }"
}

verifier_start() {
  local start=(herdr agent start "$AGENT" --kind "$VERIFIER_KIND" --pane "$PANE") out tries=0
  [[ ${#VERIFIER_ARGS[@]} -eq 0 ]] || start+=(-- "${VERIFIER_ARGS[@]}")
  # herdr refuses a pane whose new shell has not reached its prompt yet, and starts nothing then.
  until out="$("${start[@]}" 2>&1)"; do
    [[ "$out" == *agent_pane_busy* && $((tries += 1)) -lt 20 ]] || { echo "$out" >&2; return 1; }
    sleep 0.5
  done
  # shortcut: herdr reports the agent ready a moment before opencode 2.0.29 takes input, and a prompt sent at once
  # can stall; wait on a herdr signal instead if it gains one.
  sleep 2
}

prompt_verifier() { # text timeout-ms: the agent's status once it stops, or herdr's error code, such as timeout
  local out
  out="$(herdr agent prompt "$AGENT" "$1" --wait --timeout "$2" 2>&1)" || true
  node -e 'let v={};try{v=JSON.parse(process.argv[1])}catch{}console.log(v.result?.agent?.agent_status??v.error?.code??"error")' "$out"
}

# The verifier's session that began after since (epoch ms) with this prompt, as markdown from its agent's own record.
# Exits 3 for an agent kind verifier-transcript.mjs cannot read, and 1 when no session matches.
# The spec's env goes along, so a CODEX_HOME or XDG_DATA_HOME there leads the reader to the agent's sessions.
verifier_transcript() { # since prompt [--run run]
  env ${VERIFIER_ENV[@]+"${VERIFIER_ENV[@]}"} node "$BIN/verifier-transcript.mjs" --kind "$VERIFIER_KIND" --repo "$REPO" \
    --since "$1" --prompt-file <(printf '%s' "$2") "${@:3}"
}

cmd_verifier() { # ['<spec>'|off]: show the verifier delegate uses; test a spec and save it; or forget it
  [[ $# -eq 0 ]] && { verifier_status; return; }
  [[ $# -eq 1 ]] || die "usage: verify-uvw verifier ['<spec>'|off]  (quote the spec as one argument)"
  [[ "$1" != off ]] || { rm -f "$(verifier_file)"; verifier_status || true; return; }
  [[ "${HERDR_ENV:-}" == 1 ]] || die "run your agent inside a herdr pane to set a verifier up"
  parse_spec "$1" || die "the spec names no agent kind: [NAME=VALUE...] <kind> [agent args...]"
  mkdir -p "$ROOT"
  # Under ROOT, where the verifier writes evidence, so the test proves it may write there.
  SMOKE="$(mktemp -d "$ROOT/verifier-smoke.XXXXXX")" PANE=""
  trap 'rm -rf "$SMOKE"; [[ -z "$PANE" ]] || herdr pane close "$PANE" >/dev/null 2>&1 || true' EXIT
  local status reason="" file since prompt="Run this shell command, then stop: printf ok > $SMOKE/smoke" transcript
  since="$(($(date +%s) * 1000))"
  verifier_pane vu:setup setup
  verifier_start || die "herdr could not start $VERIFIER_KIND in pane $PANE"
  status="$(prompt_verifier "$prompt" 300000)"
  herdr agent read "$AGENT" --source visible --lines 30 2>/dev/null | grep -v '^[[:space:]]*$' || true
  # herdr reports done when a provider error stopped the agent, so only the file proves it ran a command.
  case "$status" in
    idle|done) [[ "$(cat "$SMOKE/smoke" 2>/dev/null)" == ok ]] || reason="the verifier did not run the command; the screen above says why" ;;
    blocked) reason="the verifier waits for approval; configure it to run commands without asking" ;;
    timeout) reason="the verifier did not stop within 5 minutes" ;;
    *) reason="herdr answered $status" ;;
  esac
  [[ -z "$reason" ]] || die "$reason; the saved verifier is unchanged"
  if transcript="$(verifier_transcript "$since" "$prompt" 2>&1)"; then
    transcript="${transcript%%$'\n'*}"
    echo "transcript: ${transcript#\# }"
  else
    echo "transcript: unavailable ($transcript); delegate saves the screen instead"
  fi
  file="$(verifier_file)"
  (umask 077 && mkdir -p "$(dirname "$file")" && printf '%s\n' \
    "# The verifier that verify-uvw delegate starts in a herdr pane. VERIFY_UVW_VERIFIER overrides this file." \
    "# One line, [NAME=VALUE...] <kind> [agent args...], split on whitespace. Each NAME=VALUE goes into the pane's env." \
    "$1" >"$file.tmp" && mv "$file.tmp" "$file")
  verifier_status
}

cmd_delegate() { # feature [journey-id|mode...]: hand this run's brief to the developer's verifier in a herdr pane, then print coverage
  [[ $# -ge 1 ]] || die "usage: verify-uvw delegate <feature> [journey-id|mode...]"
  [[ "${HERDR_ENV:-}" == 1 ]] || die "delegate opens a herdr tab; run your agent inside a herdr pane, or hand \$V brief to a subagent"
  load_verifier || die "no verifier; set one up with \$V verifier '<spec>', see .agents/skills/verify-uvw/references/delegate.md#set-up"
  load_run
  local brief held status lock="$RUN/delegate.agent" since transcript reason label="vu:$RUN_ID" procs stories
  # Command substitution drops trailing newlines, and the x keeps the brief byte for byte.
  brief="$(cmd_brief "$@" && echo x)" || exit $?
  brief="${brief%x}"
  held="$(cat "$lock" 2>/dev/null || true)"
  if [[ -n "$held" ]] && herdr agent get "$held" >/dev/null 2>&1; then
    die "verifier $held still drives run $RUN_ID; a run takes one verifier at a time"
  fi
  since="$(($(date +%s) * 1000))"
  verifier_pane "$label" "$RUN_ID-$1"
  # shortcut: the check above sees a verifier only once herdr has started it, so a second delegate in those seconds
  # starts too; take a real lock if orchestrators ever share a run.
  echo "$AGENT" >"$lock"
  verifier_start || { herdr pane close "$PANE" >/dev/null 2>&1 || true; die "herdr could not start $VERIFIER_KIND in pane $PANE"; }
  echo "verifier $AGENT in tab \"$label\" (pane $PANE): $(verifier_display)"
  status="$(prompt_verifier "$brief" 3600000)"
  case "$status" in
    idle|done)
      # A verifier can stop while a story it put in the background still runs, and closing its tab kills the story.
      # Matching the story's own arguments finds it wherever the agent runs its shells.
      procs="$(ps -Aww -o pid=,command=)"
      if stories="$(grep -F -- "$BIN/story.mjs $REPO $RUN " <<<"$procs")"; then
        echo "$stories" >&2
        die "verifier $AGENT in tab \"$label\" stopped while the stories above still run; the tab stays open so they finish. When the verifier stops after them, run \$V journeys $* and herdr pane close $PANE"
      fi
      transcript="$RUN/evidence/$AGENT.transcript.md"
      if ! reason="$(verifier_transcript "$since" "$brief" --run "$RUN" 2>&1 >"$transcript")"; then
        rm -f "$transcript"
        echo "warning: $reason; saving the verifier's screen instead" >&2
        herdr agent read "$AGENT" --source recent-unwrapped --lines 200 >"$RUN/evidence/$AGENT.screen.txt" \
          || echo "warning: cannot save the verifier's screen" >&2
      fi
      herdr pane close "$PANE" >/dev/null || echo "warning: cannot close pane $PANE; close it yourself" >&2
      cmd_journeys "$@" ;;
    blocked)
      die "verifier $AGENT waits for approval in tab \"$label\"; answer it there, or configure it to run commands without asking. Then run \$V journeys $* and herdr pane close $PANE" ;;
    *)
      herdr agent read "$AGENT" --source visible --lines 40 >&2 || true
      die "verifier $AGENT in tab \"$label\" did not stop ($status); wait with herdr agent wait $AGENT, then run \$V journeys $* and herdr pane close $PANE" ;;
  esac
}

cmd_journeys() { # feature [journey-id|mode...]: the plan before up, this run's coverage after; exit 1 while it is INCOMPLETE
  local run
  if run="$(run_dir 2>/dev/null)"; then exec node "$BIN/journeys.mjs" list --run "$run" "$@"; fi
  exec node "$BIN/journeys.mjs" list "$@"
}

cmd_verdict() { # journey-id PASS|FAIL|DRIFT|BLOCKED [note]: append this run's verdict for one journey
  local run
  run="$(run_dir)"
  exec node "$BIN/journeys.mjs" verdict --run "$run" "$@"
}

cmd_run_journeys() { # [--again] feature [journey-id|mode...]: run the helper journeys' blocks as written and record their checks
  local run
  run="$(run_dir)"
  exec node "$BIN/journeys.mjs" run --run "$run" "$@"
}

cmd_metrics() { # the Workspace server's /metrics; the token goes through stdin, never argv
  load_run
  printf 'Authorization: Bearer %s\n' "$(cat "$RUN/home/workspace-metrics-token")" \
    | curl -fsS -H @- "http://127.0.0.1:$SERVER_PORT/metrics"
}

cmd_cli() {
  [[ $# -ge 2 ]] || die "usage: verify-uvw cli <label> <uvw args...>"
  load_run
  local label="$1"; shift
  local base="$RUN/evidence/$label"
  printf 'uvw' >"$base.cmd"; printf ' %q' "$@" >>"$base.cmd"; echo >>"$base.cmd"
  local code=0
  uvw_raw "$@" >"$base.out" 2>"$base.err" || code=$?
  echo "$code" >"$base.exit"
  cat "$base.out"; cat "$base.err" >&2
  echo "[exit $code; evidence $base.{cmd,out,err,exit}]" >&2
  return "$code"
}

stop_pid() { # pid expected-command-fragment
  local pid="$1" children
  kill -0 "$pid" 2>/dev/null || return 0
  ps -p "$pid" -o command= | grep -q -- "$2" || { echo "skip pid $pid: not $2" >&2; return 0; }
  children="$(pgrep -P "$pid" || true)"
  kill "$pid" 2>/dev/null || true
  for _ in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
  kill -9 "$pid" 2>/dev/null || true
  [[ -z "$children" ]] || kill $children 2>/dev/null || true
}

cmd_down() {
  load_run
  cmd_agent_down
  [[ "${MCP_ENABLED:-0}" != 1 ]] || mcp_down
  agent-browser close >/dev/null 2>&1 || true
  # Recipes open more sessions named verify-uvw-<run>-<suffix>; the hyphen keeps run v6 off run v68's sessions.
  # shortcut: a run whose id is this id plus "-<suffix>" would lose its browser too; record session names in the run if ids ever nest.
  local session
  for session in $(agent-browser session list --json 2>/dev/null | node -e 'let names = [];
    try { names = JSON.parse(require("node:fs").readFileSync(0, "utf8")).data.sessions; } catch {}
    for (const name of names) if (name.startsWith(process.argv[1] + "-")) console.log(name);' "$AGENT_BROWSER_SESSION" || true); do
    AGENT_BROWSER_SESSION="$session" agent-browser close >/dev/null 2>&1 || true
  done
  uvw_raw daemon stop >/dev/null 2>&1 || true
  local story_home
  for story_home in "$RUN"/home/stories/uvw-*/.univer-workspace-cli; do
    # uvw keys the daemon socket by the UNIVER_HOME string, and a story runs under the real path.
    [[ ! -d "$story_home" ]] || UNIVER_HOME="$(cd -P "$story_home" && pwd)" uvw_raw daemon stop >/dev/null 2>&1 || true
  done
  stop_pid "$SERVER_PID" "server/src/main.ts"
  stop_pid "$WEB_PID" "vite.js"
  # journeys/ holds the recipe variables run-journeys carries between journeys, passwords included.
  rm -rf "$RUN/data" "$RUN/home" "$RUN/user.pw" "$RUN/journeys"
  [[ "$(readlink "$ROOT/current" 2>/dev/null)" != "$RUN" ]] || rm -f "$ROOT/current"
  echo "stopped run $RUN_ID; kept $RUN/evidence and $RUN/logs"
}

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  user) shift; cmd_user "$@" ;;
  principal) shift; cmd_principal "$@" ;;
  secret-check) shift; cmd_secret_check "$@" ;;
  story) shift; cmd_story "$@" ;;
  open-anon) shift; cmd_open_anon "$@" ;;
  env) shift; cmd_env "$@" ;;
  brief) shift; cmd_brief "$@" ;;
  verifier) shift; cmd_verifier "$@" ;;
  delegate) shift; cmd_delegate "$@" ;;
  journeys) shift; cmd_journeys "$@" ;;
  verdict) shift; cmd_verdict "$@" ;;
  run-journeys) shift; cmd_run_journeys "$@" ;;
  metrics) shift; cmd_metrics "$@" ;;
  uvw) shift; load_run; uvw_raw "$@" ;;
  cli) shift; cmd_cli "$@" ;;
  mcp) shift; cmd_mcp call "$@" ;;
  mcp-tools) shift; cmd_mcp tools "$@" ;;
  mcp-skills) shift; cmd_mcp skills "$@" ;;
  mcp-resources) shift; cmd_mcp resources "$@" ;;
  mcp-resource) shift; cmd_mcp resource "$@" ;;
  mcp-instructions) shift; cmd_mcp instructions "$@" ;;
  mcp-gateway-restart) shift; cmd_mcp_gateway_restart "$@" ;;
  mcp-allow-users) shift; cmd_mcp_allow_users "$@" ;;
  mcp-token) shift; cmd_mcp_token "$@" ;;
  mcp-oauth) shift; cmd_mcp_oauth "$@" ;;
  renderer-call) shift; cmd_renderer_call "$@" ;;
  renderer-restart) shift; cmd_renderer_restart "$@" ;;
  mcp-logs) shift; load_run; [[ "${MCP_ENABLED:-0}" == 1 ]] || die "MCP not enabled for this run"; mcp_compose logs --no-color --no-log-prefix gateway executor executor-b renderer ;;
  agent-up) shift; cmd_agent_up "$@" ;;
  agent-down) shift; cmd_agent_down "$@" ;;
  down) shift; cmd_down "$@" ;;
  *) sed -n 2,3p "$0" >&2; exit 2 ;;
esac
