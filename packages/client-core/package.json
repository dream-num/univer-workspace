{
  "name": "@univerjs/univer-workspace-client-core",
  "version": "0.0.0",
  "private": true,
  "description": "Private Univer Workspace client workflows for Node-hosted agent clients.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./product": {
      "types": "./src/product.ts",
      "development": "./src/product.ts",
      "default": "./dist/product.js"
    },
    "./worker": {
      "types": "./src/content-worker.ts",
      "development": "./src/content-worker.ts",
      "default": "./dist/content-worker.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p render-runtime/tsconfig.json --noEmit && vite build --config render-runtime/vite.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "test:board-profiles": "node scripts/verify-board-profiles.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@univer-cli/content-execution": "1.2.0",
    "@univer-cli/doc-typst-facade": "1.2.0",
    "@univer-cli/headless-univer": "1.2.0",
    "@univer-cli/svg-facade": "1.2.0",
    "@univer-cli/unit-layout-lint": "1.2.0",
    "@univer-cli/unit-pdf-printer": "1.2.0",
    "@univer-cli/unit-screenshot": "1.2.0",
    "@univer-cli/univer-collaboration-runtime": "1.2.0",
    "@univer-cli/univer-collaboration-runtime-pool": "1.2.0",
    "@univer-cli/univer-render-page": "1.2.0",
    "@univer-cli/univer-render-runtime": "1.2.0",
    "@univerjs-pro/collaboration": "1.2.0",
    "@univerjs-pro/embed": "1.2.0",
    "@univerjs-pro/exchange-node": "1.2.0",
    "@univerjs/core": "1.2.0",
    "@univerjs/protocol": "1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
