{
  "name": "univer-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:ci && pnpm test:sdk-dependencies && pnpm test:univer-license && pnpm test:release && pnpm test:docker-inputs && pnpm -r test",
    "test:sdk-dependencies": "node scripts/test.mjs node scripts/update-sdk-dependencies.test.mjs scripts/sdk-type-identity.test.mjs",
    "test:univer-license": "node scripts/test.mjs node scripts/update-univer-license.test.mjs",
    "test:release": "node scripts/test.mjs node scripts/release/*.test.mjs",
    "test:docker-inputs": "node scripts/test.mjs node scripts/docker-inputs.test.mjs",
    "check": "pnpm typecheck && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "package:workspace-cli": "pnpm --filter univer-workspace-cli package",
    "release:cli": "node scripts/release/release-cli.mjs",
    "release:cli:dev": "node scripts/release/release-cli.mjs --channel=dev --publish",
    "release:cli:publish": "node scripts/release/publish-cli.mjs",
    "update:univer-sdk": "node scripts/update-sdk-dependencies.mjs",
    "update:univer-license": "node scripts/update-univer-license.mjs",
    "link:workspace-cli": "pnpm --filter univer-workspace-cli build && pnpm link --global ./apps/cli",
    "unlink:workspace-cli": "node scripts/unlink-workspace-cli.mjs",
    "workspace:dev:web": "pnpm --filter @univerjs/univer-workspace dev:web",
    "workspace:dev:server": "pnpm --filter @univerjs/univer-workspace dev:server",
    "workspace:start": "pnpm --filter @univerjs/univer-workspace start",
    "verify": "node scripts/verify.mjs",
    "test:ci": "node scripts/test.mjs node scripts/verify.test.mjs scripts/ci-reliability.test.mjs",
    "ci:reliability": "node scripts/ci-reliability.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "0.66.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
