{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "ignorePatterns": [
    "node_modules",
    "**/lib",
    "**/dist",
    "**/.tanstack",
    "**/generated",
    "packages/dsh-univer-workspace-plugin/src/client/gen-univer.css",
    "docs/archive",
    ".zcode"
  ]
}
